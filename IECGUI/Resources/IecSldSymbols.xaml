<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- IEC 60617-inspired breaker symbol. The blade changes between open and closed states. -->
    <DataTemplate x:Key="IecBreakerSymbolTemplate">
        <Viewbox Stretch="Fill" SnapsToDevicePixels="True">
            <Canvas Width="100" Height="140">
                <Line X1="50" Y1="0" X2="50" Y2="28" Stroke="{Binding EffectiveForeground}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Rectangle x:Name="BreakerBody" Canvas.Left="25" Canvas.Top="28" Width="50" Height="58" RadiusX="5" RadiusY="5" Fill="{Binding EffectiveBackground}" Stroke="{Binding EffectiveForeground}" StrokeThickness="3"/>
                <Line X1="50" Y1="86" X2="50" Y2="140" Stroke="{Binding EffectiveForeground}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Line X1="50" Y1="28" X2="50" Y2="86" Stroke="{Binding EffectiveForeground}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Style>
                        <Style TargetType="Line">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Line.Style>
                </Line>
                <Line X1="50" Y1="34" X2="82" Y2="76" Stroke="{Binding EffectiveForeground}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Style>
                        <Style TargetType="Line">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Line.Style>
                </Line>
                <Ellipse Width="10" Height="10" Canvas.Left="45" Canvas.Top="23" Fill="{Binding EffectiveForeground}"/>
                <Ellipse Width="10" Height="10" Canvas.Left="45" Canvas.Top="81" Fill="{Binding EffectiveForeground}"/>
                <Canvas x:Name="IncomerExtras">
                    <Canvas.Style><Style TargetType="Canvas"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="Incomer"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Canvas.Style>
                    <Line X1="50" Y1="95" X2="78" Y2="95" Stroke="{Binding EffectiveForeground}" StrokeThickness="3"/>
                    <Ellipse Width="24" Height="14" Canvas.Left="70" Canvas.Top="88" Fill="Transparent" Stroke="{Binding EffectiveForeground}" StrokeThickness="2"/>
                    <Line X1="50" Y1="112" X2="78" Y2="112" Stroke="{Binding EffectiveForeground}" StrokeThickness="3"/>
                    <Ellipse Width="24" Height="14" Canvas.Left="70" Canvas.Top="105" Fill="Transparent" Stroke="{Binding EffectiveForeground}" StrokeThickness="2"/>
                </Canvas>
                <Canvas x:Name="CouplerExtras">
                    <Canvas.Style><Style TargetType="Canvas"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="BusCoupler"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Canvas.Style>
                    <Line X1="10" Y1="57" X2="25" Y2="57" Stroke="{Binding EffectiveForeground}" StrokeThickness="4"/>
                    <Line X1="75" Y1="57" X2="90" Y2="57" Stroke="{Binding EffectiveForeground}" StrokeThickness="4"/>
                </Canvas>
                <Canvas x:Name="OutgoingExtras">
                    <Canvas.Style><Style TargetType="Canvas"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="Outgoing"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Canvas.Style>
                    <Line X1="50" Y1="98" X2="50" Y2="112" Stroke="{Binding EffectiveForeground}" StrokeThickness="4"/>
                    <Ellipse Width="32" Height="24" Canvas.Left="34" Canvas.Top="112" Fill="Transparent" Stroke="{Binding EffectiveForeground}" StrokeThickness="3"/>
                </Canvas>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    

    <Style x:Key="ScadaFlowLineStyle" TargetType="{x:Type Line}">
        <Setter Property="StrokeDashArray" Value="2,5"/>
        <Setter Property="StrokeDashOffset" Value="0"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsFlowRunning}" Value="True"/>
                    <Condition Binding="{Binding FlowDirection}" Value="Forward"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset" From="0" To="7" Duration="0:0:0.65"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsFlowRunning}" Value="True"/>
                    <Condition Binding="{Binding FlowDirection}" Value="Reverse"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset" From="7" To="0" Duration="0:0:0.65"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>