<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- IEC 60617-inspired ACB/VCB symbols. Legacy Incomer/BusCoupler/Outgoing
         values intentionally fall back to the default VCB rendering. -->
    <DataTemplate x:Key="IecBreakerSymbolTemplate">
        <Viewbox Stretch="Fill" SnapsToDevicePixels="True">
            <Canvas Width="100" Height="140">
                <Line X1="50" Y1="0" X2="50" Y2="31" Stroke="{Binding EffectiveForeground}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Line X1="50" Y1="98" X2="50" Y2="140" Stroke="{Binding EffectiveForeground}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                <!-- VCB: fixed contact geometry; only the enclosure fill follows the live state. -->
                <Rectangle Canvas.Left="25" Canvas.Top="31" Width="50" Height="67" Fill="{Binding EffectiveBackground}" Stroke="{Binding EffectiveForeground}" StrokeThickness="3">
                    <Rectangle.Style><Style TargetType="Rectangle"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding EffectiveSymbolKind}" Value="VCB"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Rectangle.Style>
                </Rectangle>
                <Line X1="29" Y1="35" X2="71" Y2="94" Stroke="{Binding EffectiveForeground}" StrokeThickness="3">
                    <Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding EffectiveSymbolKind}" Value="VCB"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style>
                </Line>
                <Line X1="71" Y1="35" X2="29" Y2="94" Stroke="{Binding EffectiveForeground}" StrokeThickness="3">
                    <Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding EffectiveSymbolKind}" Value="VCB"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style>
                </Line>
                <Line X1="42" Y1="18" X2="50" Y2="30" Stroke="{Binding EffectiveForeground}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding EffectiveSymbolKind}" Value="VCB"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style>
                </Line>
                
                <Line X1="58" Y1="18" X2="50" Y2="30" Stroke="{Binding EffectiveForeground}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding EffectiveSymbolKind}" Value="VCB"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style>
                </Line>
                <Line X1="42" Y1="112" X2="50" Y2="99" Stroke="{Binding EffectiveForeground}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding EffectiveSymbolKind}" Value="VCB"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style>
                </Line>
                <Line X1="58" Y1="112" X2="50" Y2="99" Stroke="{Binding EffectiveForeground}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding EffectiveSymbolKind}" Value="VCB"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style>
                </Line>

                <!-- TOP: NEW second chevron, shifted further up by 16 units -->
                <Line X1="42" Y1="2" X2="50" Y2="14" Stroke="{Binding EffectiveForeground}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Style>
                        <Style TargetType="Line">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EffectiveSymbolKind}" Value="VCB">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Line.Style>
                </Line>
                <Line X1="58" Y1="2" X2="50" Y2="14" Stroke="{Binding EffectiveForeground}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Style>
                        <Style TargetType="Line">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EffectiveSymbolKind}" Value="VCB">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Line.Style>
                </Line>

                <!-- BOTTOM: NEW second chevron, shifted further down by 16 units -->
                <Line X1="42" Y1="128" X2="50" Y2="116" Stroke="{Binding EffectiveForeground}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Style>
                        <Style TargetType="Line">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EffectiveSymbolKind}" Value="VCB">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Line.Style>
                </Line>
                <Line X1="58" Y1="128" X2="50" Y2="116" Stroke="{Binding EffectiveForeground}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Style>
                        <Style TargetType="Line">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EffectiveSymbolKind}" Value="VCB">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Line.Style>
                </Line>

                <!-- ACB: standard open blade / closed contact. -->
                <Line X1="50" Y1="31" X2="50" Y2="98" Stroke="{Binding EffectiveForeground}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Style>
                        <Style TargetType="Line">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding EffectiveSymbolKind}" Value="ACB"/><Condition Binding="{Binding IsOn}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Line.Style>
                </Line>
                <Line X1="50" Y1="37" X2="78" Y2="83" Stroke="{Binding EffectiveForeground}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Style>
                        <Style TargetType="Line">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding EffectiveSymbolKind}" Value="ACB"/><Condition Binding="{Binding IsOn}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Line.Style>
                </Line>
                <Line X1="41" Y1="35" X2="59" Y2="53" Stroke="{Binding EffectiveForeground}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding EffectiveSymbolKind}" Value="ACB"/><Condition Binding="{Binding IsOn}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Line.Style>
                </Line>
                <Line X1="59" Y1="35" X2="41" Y2="53" Stroke="{Binding EffectiveForeground}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding EffectiveSymbolKind}" Value="ACB"/><Condition Binding="{Binding IsOn}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Line.Style>
                </Line>
                <Ellipse Width="8" Height="8" Canvas.Left="46" Canvas.Top="27" Fill="{Binding EffectiveForeground}"/>
                <Ellipse Width="8" Height="8" Canvas.Left="46" Canvas.Top="94" Fill="{Binding EffectiveForeground}"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- Compact vector primitives used by the expanded IEC library. -->
    <DataTemplate x:Key="IecDeviceSymbolTemplate">
        <Viewbox Stretch="Fill" SnapsToDevicePixels="True">
            <Canvas Width="120" Height="90">
                <Line X1="60" Y1="0" X2="60" Y2="90" Stroke="{Binding EffectiveForeground}" StrokeThickness="3"/>
                <Rectangle Canvas.Left="34" Canvas.Top="27" Width="52" Height="36" Fill="{Binding EffectiveBackground}" Stroke="{Binding EffectiveForeground}" StrokeThickness="3">
                    <Rectangle.Style><Style TargetType="Rectangle"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="Fuse"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Rectangle.Style>
                </Rectangle>
                <Line X1="40" Y1="33" X2="80" Y2="57" Stroke="{Binding EffectiveForeground}" StrokeThickness="3"><Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="Fuse"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style></Line>
                <Line X1="44" Y1="32" X2="76" Y2="58" Stroke="{Binding EffectiveForeground}" StrokeThickness="3"><Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="Fuse"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style></Line>
                <Line X1="50" Y1="30" X2="80" Y2="60" Stroke="{Binding EffectiveForeground}" StrokeThickness="3"><Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="Disconnector"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style></Line>
                <Line X1="50" Y1="30" X2="76" Y2="58" Stroke="{Binding EffectiveForeground}" StrokeThickness="3"><Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="EarthSwitch"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style></Line>
                <Ellipse Canvas.Left="38" Canvas.Top="20" Width="44" Height="22" Fill="Transparent" Stroke="{Binding EffectiveForeground}" StrokeThickness="3"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="CT"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                <Ellipse Canvas.Left="38" Canvas.Top="48" Width="44" Height="22" Fill="Transparent" Stroke="{Binding EffectiveForeground}" StrokeThickness="3"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="Transformer"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding SymbolKind}" Value="VT"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                <Ellipse Canvas.Left="35" Canvas.Top="20" Width="50" Height="50" Fill="{Binding EffectiveBackground}" Stroke="{Binding EffectiveForeground}" StrokeThickness="3"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="Motor"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding SymbolKind}" Value="Generator"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                <TextBlock Canvas.Left="53" Canvas.Top="31" Text="M" Foreground="{Binding EffectiveForeground}" FontSize="22" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="Motor"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <TextBlock Canvas.Left="53" Canvas.Top="31" Text="G" Foreground="{Binding EffectiveForeground}" FontSize="22" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="Generator"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <Line X1="43" Y1="30" X2="77" Y2="30" Stroke="{Binding EffectiveForeground}" StrokeThickness="4"><Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="Capacitor"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style></Line>
                <Line X1="43" Y1="60" X2="77" Y2="60" Stroke="{Binding EffectiveForeground}" StrokeThickness="4"><Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="Capacitor"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style></Line>
                <Line X1="40" Y1="68" X2="80" Y2="68" Stroke="{Binding EffectiveForeground}" StrokeThickness="2"><Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="EarthSwitch"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style></Line>
                <Line X1="46" Y1="73" X2="74" Y2="73" Stroke="{Binding EffectiveForeground}" StrokeThickness="2"><Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="EarthSwitch"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style></Line>
                <Line X1="52" Y1="78" X2="68" Y2="78" Stroke="{Binding EffectiveForeground}" StrokeThickness="2"><Line.Style><Style TargetType="Line"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SymbolKind}" Value="EarthSwitch"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style></Line>
            </Canvas>
        </Viewbox>
    </DataTemplate>
</ResourceDictionary>
