<UserControl x:Class="IECGUI.Controls.AnalogGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="250"
             d:DesignHeight="190">
    <Grid Width="250" Height="190" ClipToBounds="False">
        <Grid.Effect>
            <DropShadowEffect Color="#48D9FF" BlurRadius="18" ShadowDepth="0" Opacity="0.28"/>
        </Grid.Effect>

        <Ellipse Width="156"
                 Height="156"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,4,0,0"
                 Stroke="#2248D9FF"
                 StrokeThickness="1"
                 StrokeDashArray="8 7"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="OuterRingRotate"/>
            </Ellipse.RenderTransform>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="OuterRingRotate"
                                             Storyboard.TargetProperty="Angle"
                                             From="0"
                                             To="360"
                                             Duration="0:0:18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <Path Stroke="#263A4B"
              StrokeThickness="18"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Data="M 48,124 A 77,77 0 0 1 202,124"/>

        <Path Stroke="#34D85F"
              StrokeThickness="10"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Data="M 48,124 A 77,77 0 0 1 92,54"/>

        <Path Stroke="#FFAA15"
              StrokeThickness="10"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Data="M 92,54 A 77,77 0 0 1 158,54"/>

        <Path Stroke="#FF1D1D"
              StrokeThickness="10"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Data="M 158,54 A 77,77 0 0 1 202,124"/>

        <Path Stroke="#8FF0FF"
              StrokeThickness="2"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Opacity="0.72"
              Data="M 55,124 A 70,70 0 0 1 195,124"/>

        <Ellipse Width="82"
                 Height="82"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,76,0,0"
                 Fill="#AA071522"
                 Stroke="#7748D9FF"
                 StrokeThickness="1"/>

        <Line x:Name="Needle"
              X1="125"
              Y1="124"
              X2="125"
              Y2="58"
              Stroke="#F1FDFF"
              StrokeThickness="4"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Triangle">
            <Line.Effect>
                <DropShadowEffect Color="#D6FFFF" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
            </Line.Effect>
            <Line.RenderTransform>
                <RotateTransform x:Name="NeedleRotate"
                                 CenterX="125"
                                 CenterY="124"/>
            </Line.RenderTransform>
        </Line>

        <Ellipse Width="13"
                 Height="13"
                 Fill="#F1FDFF"
                 Stroke="#48D9FF"
                 StrokeThickness="2"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,118,0,0"/>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,84,0,0">
            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
                                     Path=Value,
                                     StringFormat={}{0:F1}}"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#48D9FF" BlurRadius="12" ShadowDepth="0" Opacity="0.75"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
                                     Path=Unit}"
                       Foreground="#C7F3FF"
                       FontSize="15"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,-2,0,0"/>
        </StackPanel>

        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
                                 Path=Title}"
                   Foreground="White"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,2"/>
    </Grid>
</UserControl>
