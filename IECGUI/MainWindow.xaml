<Window x:Class="IECGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#06111C"
        Title="Energy Monitoring Dashboard"
        Height="1080"
        Width="1920">
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080" ClipToBounds="True">
            <ContentControl Content="{Binding Navigation.CurrentView}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,18,24,0"
                        Panel.ZIndex="1000">
                <Button Command="{Binding LogoutCommand}"
                        ToolTip="Logout"
                        Width="64"
                        Height="64"
                        Margin="0,0,12,0"
                        Background="#38192D3B"
                        BorderBrush="#66BFEFFF"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Path Data="{StaticResource Icon_Logout}"
                          Fill="White"
                          Height="30"
                          Width="30"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Button>

                <Button Command="{Binding CloseAppCommand}"
                        ToolTip="Close Application"
                        Width="64"
                        Height="64"
                        Background="#38192D3B"
                        BorderBrush="#66BFEFFF"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Path Data="M 10,10 L 30,30 M 30,10 L 10,30"
                          Stroke="White"
                          StrokeThickness="3.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Height="30"
                          Width="30"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <Grid Visibility="{Binding AlarmService.AlarmPopupVisibility}"
                  Background="#66000000"
                  Panel.ZIndex="900"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Border Width="640"
                        Height="380"
                        CornerRadius="8"
                        Background="#F20A1A28"
                        BorderBrush="#CCFF746D"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF746D" BlurRadius="34" ShadowDepth="0" Opacity="0.75"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="82"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="86"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#33FF746D"
                                BorderBrush="#66FF746D"
                                BorderThickness="0,0,0,1">
                            <DockPanel Margin="24,0">
                                <Border Width="46"
                                        Height="46"
                                        CornerRadius="23"
                                        BorderBrush="#FFFFA29D"
                                        BorderThickness="2"
                                        Background="#33FF746D"
                                        DockPanel.Dock="Left"
                                        VerticalAlignment="Center"
                                        Margin="0,0,16,0">
                                    <TextBlock Text="!"
                                               Foreground="#FFFFA29D"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ALARM RAISED"
                                               Foreground="White"
                                               FontSize="28"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding AlarmService.CurrentPopupAlarm.SeverityText}"
                                               Foreground="#FFFFA29D"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1" Margin="28,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding AlarmService.CurrentPopupAlarm.AlarmName}"
                                       Foreground="White"
                                       FontSize="26"
                                       FontWeight="Bold"/>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding AlarmService.CurrentPopupAlarm.Message}"
                                       Foreground="#BCEFFF"
                                       FontSize="18"
                                       Margin="0,12,0,0"/>
                            <UniformGrid Grid.Row="2" Columns="3" Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="Meter" Foreground="#8FDDEA" FontSize="13"/>
                                    <TextBlock Text="{Binding AlarmService.CurrentPopupAlarm.MeterName}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Value" Foreground="#8FDDEA" FontSize="13"/>
                                    <TextBlock Text="{Binding AlarmService.CurrentPopupAlarm.ValueText}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Time" Foreground="#8FDDEA" FontSize="13"/>
                                    <TextBlock Text="{Binding AlarmService.CurrentPopupAlarm.RaisedAtText}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </UniformGrid>
                        </Grid>

                        <Grid Grid.Row="2" Margin="28,0,28,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="ACKNOWLEDGE"
                                    Command="{Binding AlarmService.AcknowledgeCurrentCommand}"
                                    Style="{StaticResource GlassButton.Cyan}"
                                    Height="52"
                                    Margin="0,0,10,0"/>
                            <Button Grid.Column="1"
                                    Content="DISMISS"
                                    Command="{Binding AlarmService.DismissPopupCommand}"
                                    Style="{StaticResource GlassButton.Ghost}"
                                    Height="52"
                                    Margin="10,0,0,0"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Viewbox>
</Window>
