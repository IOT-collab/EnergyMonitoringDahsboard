<Window x:Class="IECGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#06111C"
        Title="Energy Monitoring Dashboard"
        Height="1080"
        Width="1920">
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080" ClipToBounds="True">
            <ContentControl Content="{Binding Navigation.CurrentView}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,18,24,0"
                        Panel.ZIndex="1000">
                <Button Command="{Binding LogoutCommand}"
                        ToolTip="Logout"
                        Width="64"
                        Height="64"
                        Margin="0,0,12,0"
                        Background="#38192D3B"
                        BorderBrush="#66BFEFFF"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Path Data="{StaticResource Icon_Logout}"
                          Fill="White"
                          Height="30"
                          Width="30"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Button>

                <Button Command="{Binding CloseAppCommand}"
                        ToolTip="Close Application"
                        Width="64"
                        Height="64"
                        Background="#38192D3B"
                        BorderBrush="#66BFEFFF"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Path Data="M 10,10 L 30,30 M 30,10 L 10,30"
                          Stroke="White"
                          StrokeThickness="3.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Height="30"
                          Width="30"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

        </Grid>
    </Viewbox>
</Window>
