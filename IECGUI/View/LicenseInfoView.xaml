<UserControl x:Class="IECGUI.View.LicenseInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1920" Height="1080">
    <Grid Background="#081421">
        <Grid.RowDefinitions>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#102A3E" BorderBrush="#315B73" BorderThickness="0,0,0,1">
            <Grid Margin="32,0">
                <TextBlock Text="LICENSE INFORMATION"
                           Foreground="White" FontSize="30" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1200,0,0,0">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                            Style="{StaticResource GlassButton.Cyan}" Width="130" Height="42" Margin="0,0,12,0"/>
                    <Button Content="Back" Command="{Binding BackCommand}"
                            Style="{StaticResource GlassButton.Cyan}" Width="130" Height="42"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Width="980" Margin="0,70,0,90">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="32" CornerRadius="12"
                        Background="#B3132A3E" BorderBrush="#467C9A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="License status" Foreground="#9ADCF0" FontSize="17"/>
                            <TextBlock Text="{Binding Status}" Foreground="#4BE5A0" FontSize="34" FontWeight="Bold" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#C3EAF5" FontSize="16"
                                       TextWrapping="Wrap" Margin="0,8,20,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Time remaining" Foreground="#9ADCF0" FontSize="17"/>
                            <TextBlock Text="{Binding TimeRemaining}" Foreground="#4EC9FF" FontSize="34" FontWeight="Bold" Margin="0,5,0,0"/>
                            <TextBlock Text="Expiry: {Binding ExpiresOn}" Foreground="#C3EAF5" FontSize="16" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Padding="32" Margin="0,18,0,0" CornerRadius="12"
                        Background="#B3132A3E" BorderBrush="#467C9A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Product" Foreground="#9ADCF0" FontSize="16" Margin="0,0,0,16"/>
                            <TextBlock Text="Installation ID" Foreground="#9ADCF0" FontSize="16" Margin="0,0,0,16"/>
                            <TextBlock Text="Installed on" Foreground="#9ADCF0" FontSize="16" Margin="0,0,0,16"/>
                            <TextBlock Text="License type" Foreground="#9ADCF0" FontSize="16" Margin="0,0,0,16"/>
                            <TextBlock Text="Issued on" Foreground="#9ADCF0" FontSize="16" Margin="0,0,0,16"/>
                            <TextBlock Text="Product key" Foreground="#9ADCF0" FontSize="16"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Product}" Foreground="White" FontSize="16" Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding InstallationId}" Foreground="White" FontSize="16" Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding InstalledOn}" Foreground="White" FontSize="16" Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding LicenseType}" Foreground="White" FontSize="16" Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding IssuedOn}" Foreground="White" FontSize="16" Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding ProductKeyInfo}" Foreground="#BCEFFF" FontSize="16" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2" Text="The complete product key is not displayed for security. Contact the vendor for renewal or a replacement key."
                           Foreground="#9ADCF0" FontSize="15" TextWrapping="Wrap" Margin="4,20,4,0"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
