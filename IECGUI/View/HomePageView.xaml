<UserControl x:Class="IECGUI.View.HomePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="930" d:DesignWidth="1920"
             Background="Transparent">
    <UserControl.Resources>
        <SolidColorBrush x:Key="HomeCyan" Color="#48D9FF"/>
        <SolidColorBrush x:Key="HomeCyanSoft" Color="#A8EEFF"/>
        <SolidColorBrush x:Key="HomeText" Color="#F4FAFF"/>
        <SolidColorBrush x:Key="HomeMutedText" Color="#A9D8EC"/>
        <SolidColorBrush x:Key="HomeDanger" Color="#FF806F"/>

        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Height" Value="132"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#466F96B4"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#361A3650" Offset="0"/>
                        <GradientStop Color="#70101F32" Offset="0.55"/>
                        <GradientStop Color="#4513263E" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#2BE7FF" BlurRadius="18" ShadowDepth="0" Opacity="0.18"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardTileButton" TargetType="Button">
            <Setter Property="Height" Value="235"/>
            <Setter Property="Foreground" Value="{StaticResource HomeText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder"
                                CornerRadius="8"
                                BorderThickness="1.5"
                                BorderBrush="#88AEEAFF">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6D334A60" Offset="0"/>
                                    <GradientStop Color="#5C13263B" Offset="0.52"/>
                                    <GradientStop Color="#8A0F2435" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#2DE9FF" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>

                            <Grid>
                                <Border Height="58"
                                        VerticalAlignment="Top"
                                        Margin="2"
                                        CornerRadius="7,7,0,0"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#68FFFFFF" Offset="0"/>
                                            <GradientStop Color="#05FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Border Height="5"
                                        Width="180"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,-2"
                                        Background="#35E8FF"
                                        CornerRadius="6"
                                        IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#35E8FF" BlurRadius="20" ShadowDepth="0" Opacity="0.75"/>
                                    </Border.Effect>
                                </Border>

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#D6F7FF"/>
                                <Setter TargetName="TileBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#88476778" Offset="0"/>
                                            <GradientStop Color="#6B17344D" Offset="0.55"/>
                                            <GradientStop Color="#9422455C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="TileBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileIconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="84"/>
            <Setter Property="Foreground" Value="{StaticResource HomeCyanSoft}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#61E7FF" BlurRadius="18" ShadowDepth="0" Opacity="0.75"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource HomeText}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,18,0,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.7"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Width="1920" Height="930" ClipToBounds="True">
        <Image Source="pack://application:,,,/IECGUI.Visuals;component/Images/Backend.jpg"
               Stretch="UniformToFill"
               Opacity="0.62"/>
        <Rectangle Fill="#B804111D"/>
        <Rectangle Opacity="0.45">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.15" GradientOrigin="0.5,0.15" RadiusX="0.86" RadiusY="0.66">
                    <GradientStop Color="#37325E79" Offset="0"/>
                    <GradientStop Color="#00030A12" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="64,34,64,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="122"/>
                <RowDefinition Height="132"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Width="88" Height="88" VerticalAlignment="Center">
                    <Ellipse Stroke="#31DAEE" StrokeThickness="2" StrokeDashArray="14 12"/>
                    <Border Width="45" Height="45" CornerRadius="7" BorderBrush="#44E8FF" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#35E8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0,0,0">
                    <TextBlock Text="Energy Monitoring Dashboard"
                               Foreground="{StaticResource HomeText}"
                               FontSize="32"
                               FontWeight="Bold"/>
                    <TextBlock Text="Real-time monitoring. Intelligent insights. Reliable energy."
                               Foreground="#79DCF3"
                               FontSize="18"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="13" Height="13" Fill="#4BD050" VerticalAlignment="Center"/>
                    <TextBlock Text="System Online" Foreground="{StaticResource HomeText}" FontSize="17" Margin="14,0,42,0" VerticalAlignment="Center"/>
                    <Rectangle Width="1.4" Height="30" Fill="#88A8C3D4" Margin="0,0,42,0"/>
                    <TextBlock Text="&#xE83D;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#47D946" VerticalAlignment="Center"/>
                    <TextBlock Text="Secure" Foreground="{StaticResource HomeText}" FontSize="17" Margin="14,0,42,0" VerticalAlignment="Center"/>
                    <Rectangle Width="1.4" Height="30" Fill="#88A8C3D4" Margin="0,0,42,0"/>
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#35E8FF" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource KpiCardStyle}" Padding="28,18" Margin="0,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="57" Foreground="#74E8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Live Load" Foreground="{StaticResource HomeText}" FontSize="16" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="1,245" Foreground="#4EC9FF" FontSize="34" FontWeight="Bold"/>
                                <TextBlock Text=" MW" Foreground="{StaticResource HomeText}" FontSize="18" Margin="8,11,0,0"/>
                            </StackPanel>
                            <TextBlock Text="72% of Capacity" Foreground="{StaticResource HomeMutedText}" FontSize="16"/>
                        </StackPanel>
                        <Polyline Grid.Column="2" Points="0,64 12,57 24,67 36,66 48,54 60,62 72,49 84,50 96,40 108,43"
                                  Stroke="#35E8FF" StrokeThickness="2" VerticalAlignment="Center"/>
                    </Grid>

                    <Rectangle Grid.Column="1" Fill="#59779CB3" Margin="0,20"/>

                    <Grid Grid.Column="2" Margin="26,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xEADF;" FontFamily="Segoe MDL2 Assets" FontSize="61" Foreground="#74E8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Power Factor" Foreground="{StaticResource HomeText}" FontSize="16" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="0.96" Foreground="#4EC9FF" FontSize="34" FontWeight="Bold"/>
                                <TextBlock Text=" PF" Foreground="{StaticResource HomeText}" FontSize="18" Margin="8,11,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Leading" Foreground="#4BD050" FontSize="16"/>
                        </StackPanel>
                        <Polyline Grid.Column="2" Points="0,64 12,58 24,59 36,50 48,56 60,48 72,52 84,43 96,45 108,38"
                                  Stroke="#35E8FF" StrokeThickness="2" VerticalAlignment="Center"/>
                    </Grid>

                    <Rectangle Grid.Column="3" Fill="#59779CB3" Margin="0,20"/>

                    <Grid Grid.Column="4" Margin="26,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="59" Foreground="#BCEBFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Energy Today" Foreground="{StaticResource HomeText}" FontSize="16" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="18,742" Foreground="#4EC9FF" FontSize="34" FontWeight="Bold"/>
                                <TextBlock Text=" MWh" Foreground="{StaticResource HomeText}" FontSize="18" Margin="8,11,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Up 8.4% vs Yesterday" Foreground="#4BD050" FontSize="16"/>
                        </StackPanel>
                        <Polyline Grid.Column="2" Points="0,64 12,58 24,62 36,51 48,59 60,49 72,53 84,43 96,48 108,38"
                                  Stroke="#35E8FF" StrokeThickness="2" VerticalAlignment="Center"/>
                    </Grid>

                    <Rectangle Grid.Column="5" Fill="#59779CB3" Margin="0,20"/>

                    <Grid Grid.Column="6" Margin="26,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="60" Foreground="{StaticResource HomeDanger}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Active Alerts" Foreground="{StaticResource HomeText}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="3" Foreground="{StaticResource HomeDanger}" FontSize="34" FontWeight="Bold" Margin="0,5,0,0"/>
                            <TextBlock Text="High Priority" Foreground="{StaticResource HomeDanger}" FontSize="16"/>
                        </StackPanel>
                        <Polyline Grid.Column="2" Points="0,64 12,58 24,62 36,59 48,49 60,55 72,45 84,52 96,47 108,38"
                                  Stroke="#FF806F" StrokeThickness="2" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="42,48,42,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="235"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="235"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource DashboardTileButton}" Command="{Binding SldViewCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileIconText}" Text="&#xE968;"/>
                        <TextBlock Style="{StaticResource TileTitleText}" Text="SLD View"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource DashboardTileButton}" Command="{Binding EnergyViewCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileIconText}" Text="&#xE945;"/>
                        <TextBlock Style="{StaticResource TileTitleText}" Text="Energy Monitor"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource DashboardTileButton}" Command="{Binding GaugeViewCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileIconText}" Text="&#xE9D9;"/>
                        <TextBlock Style="{StaticResource TileTitleText}" Text="GaugeView"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="6" Style="{StaticResource DashboardTileButton}" Command="{Binding ConfigViewCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileIconText}" Text="&#xE713;"/>
                        <TextBlock Style="{StaticResource TileTitleText}" Text="Device Config"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource DashboardTileButton}" Command="{Binding ProtRelayMonitorViewCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileIconText}" Text="&#xE7F4;"/>
                        <TextBlock Style="{StaticResource TileTitleText}" Text="Relay Monitor"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource DashboardTileButton}" Command="{Binding MqttViewCommad}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileIconText}" Text="&#xE774;"/>
                        <TextBlock Style="{StaticResource TileTitleText}" Text="Remote View"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource DashboardTileButton}" Command="{Binding ReportViewerCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileIconText}" Text="&#xE9D2;"/>
                        <TextBlock Style="{StaticResource TileTitleText}" Text="Reports"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="6" Style="{StaticResource DashboardTileButton}" Command="{Binding AlarmViewCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileIconText}" Text="&#xE7BA;" Foreground="{StaticResource HomeDanger}"/>
                        <TextBlock Style="{StaticResource TileTitleText}" Text="Alarms"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
