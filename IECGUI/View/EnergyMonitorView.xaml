<UserControl x:Class="IECGUI.View.EnergyMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IECGUI.View"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#081421" Offset="0"/>
                <GradientStop Color="#142B3D" Offset="0.55"/>
                <GradientStop Color="#06101A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#6614263A" BorderBrush="#667ECBE5" BorderThickness="0,0,0,1" Grid.Row="0" Padding="20,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Energy Monitoring Dashboard"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Connect" Foreground="White" Width="200" FontSize="20" FontWeight="ExtraBold" Background="LimeGreen" Margin="5" HorizontalAlignment="Center" Style="{StaticResource GlassButton}" Command="{Binding Connect}"/>
                <Button Grid.Column="2" Content="Disconnect" Foreground="White" Width="200" FontSize="20" FontWeight="ExtraBold" Background="Red" Margin="5" HorizontalAlignment="Left" Style="{StaticResource GlassButton}" Command="{Binding Disconnect}"/>
                <Button Grid.Column="3" x:Name="BACK" Content="BACK" Foreground="White" Width="100" HorizontalAlignment="Left" Margin="150,5,5,5" Style="{StaticResource GlassButton.Cyan}" Command="{Binding ReturnToHome}"/>
            </Grid>
        </Border>
        

        <!-- Meter Panels -->
        <ScrollViewer Grid.Row="1" Background="Transparent" VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Meters}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Margin="8"
                                Width="430"
                                Height="500"
                                Background="#6614263A" 
                                BorderBrush="#667ECBE5"
                                CornerRadius="8"
                                BorderThickness="1" >

                            <Grid Margin="10">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="35"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!--================ HEADER =================-->

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding MeterName}"
                                               Grid.Column="0"
                                               VerticalAlignment="Top"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#48D9FF"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,14,0"/>

                                    <Border Grid.Column="1"
                                            Background="#44101F32"
                                            BorderBrush="#557ECBE5"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10,2"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding MeterStatus}"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="130"/>
                                    </Border>
                                </Grid>

                                <!--================ BODY =================-->

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding Parameters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="31">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.5*"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="0.8*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding ParameterName}"
                                                               Foreground="#A8EEFF"
                                                               FontSize="18"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ParameterName}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayValue}"
                                                               Foreground="White"
                                                               FontSize="17"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"
                                                               Margin="6,0,10,0"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Unit}"
                                                               Foreground="White"
                                                               FontSize="17"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>
        

        </ScrollViewer>

        <!-- Event Grid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Events}"
                  AutoGenerateColumns="False">
            

            <DataGrid.Columns>

                <DataGridTextColumn Header="Time"
                                    Binding="{Binding Time}"/>

                <DataGridTextColumn Header="Source"
                                    Binding="{Binding Source}"/>

                <DataGridTextColumn Header="Message"
                                    Binding="{Binding Message}"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</UserControl>

