<UserControl x:Class="IECGUI.View.EnergyMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="1080"
             d:DesignWidth="1920">
    <UserControl.Resources>
        <DropShadowEffect x:Key="MonitorGlow"
                          Color="#24DFFF"
                          BlurRadius="22"
                          ShadowDepth="0"
                          Opacity="0.18"/>

        <Style x:Key="MonitorPanel" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D0143048" Offset="0"/>
                        <GradientStop Color="#EA071827" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#7352BFE0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect" Value="{StaticResource MonitorGlow}"/>
        </Style>

        <Style x:Key="ReadingName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A8EEFF"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="ReadingValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ReadingUnit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDF8FF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EventGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#E706111D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RowBackground" Value="#4414263A"/>
            <Setter Property="AlternatingRowBackground" Value="#55203349"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#06111C" Offset="0"/>
                <GradientStop Color="#0A2032" Offset="0.54"/>
                <GradientStop Color="#06101A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="108"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="4" IsHitTestVisible="False" Opacity="0.32">
            <Grid.Background>
                <DrawingBrush TileMode="Tile"
                              Viewport="0,0,48,48"
                              ViewportUnits="Absolute"
                              Stretch="None">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="Transparent">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#2436DFFF" Thickness="1"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="48,0" EndPoint="48,48"/>
                                    <LineGeometry StartPoint="0,48" EndPoint="48,48"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Grid.Background>
        </Grid>

        <Border Grid.Row="0"
                Background="#E706111D"
                BorderBrush="#526EDFFF"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="172"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Energy Monitoring Dashboard"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Connect"
                        Foreground="White"
                        FontSize="20"
                        FontWeight="ExtraBold"
                        Style="{StaticResource GlassButton.Green}"
                        Command="{Binding Connect}"
                        Height="42"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="3"
                        Content="Disconnect"
                        Foreground="White"
                        FontSize="20"
                        FontWeight="ExtraBold"
                        Style="{StaticResource GlassButton.Red}"
                        Command="{Binding Disconnect}"
                        Height="42"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="5"
                        Content="Back"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        Style="{StaticResource GlassButton.Cyan}"
                        Command="{Binding ReturnToHome}"
                        Height="42"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,18,196,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MonitorPanel}" Padding="18,12">
                <DockPanel>
                    <Border Width="44" Height="44" CornerRadius="7" Background="#263EEBFF" DockPanel.Dock="Left" Margin="0,0,12,0">
                        <Path Data="M 22,4 L 12,25 L 22,25 L 16,40 L 34,17 L 24,17 Z"
                              Fill="#69F1FF"
                              Width="24"
                              Height="30"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Polling Cycle" Foreground="#A8EEFF" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="500 ms live scan" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MonitorPanel}" Padding="18,12">
                <DockPanel>
                    <Border Width="44" Height="44" CornerRadius="7" Background="#263EEBFF" DockPanel.Dock="Left" Margin="0,0,12,0">
                        <Path Data="M 8,14 L 36,14 M 8,26 L 36,26 M 14,8 L 14,32 M 30,8 L 30,32"
                              Stroke="#69F1FF"
                              StrokeThickness="3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="30"
                              Height="30"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Configured Meters" Foreground="#A8EEFF" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Meters.Count, StringFormat={}{0} meters}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource MonitorPanel}" Padding="18,12">
                <DockPanel>
                    <Border Width="44" Height="44" CornerRadius="7" Background="#263EEBFF" DockPanel.Dock="Left" Margin="0,0,12,0">
                        <Path Data="M 7,25 L 15,25 L 19,15 L 27,35 L 31,25 L 39,25"
                              Stroke="#69F1FF"
                              StrokeThickness="3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="32"
                              Height="32"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Logging" Foreground="#A8EEFF" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="CSV ready" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource MonitorPanel}" Padding="18,12">
                <DockPanel>
                    <Border Width="44" Height="44" CornerRadius="7" Background="#263EEBFF" DockPanel.Dock="Left" Margin="0,0,12,0">
                        <Path Data="M 22,5 A 17,17 0 1 0 22,39 A 17,17 0 1 0 22,5 M 22,12 L 22,23 L 31,28"
                              Stroke="#69F1FF"
                              StrokeThickness="3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="32"
                              Height="32"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Status" Foreground="#A8EEFF" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="Live monitor" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      Margin="24,18,24,18"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Background="Transparent">
            <ItemsControl ItemsSource="{Binding Meters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="780"
                                Height="455"
                                Margin="12"
                                Style="{StaticResource MonitorPanel}"
                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="58"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        BorderBrush="#2952BFE0"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,0,0,12">
                                    <DockPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding MeterName}"
                                                       Foreground="#48D9FF"
                                                       FontSize="22"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="{Binding MeterStatus}"
                                                       Foreground="White"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="540"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right"
                                                Height="30"
                                                MinWidth="100"
                                                Padding="16,0"
                                                CornerRadius="15"
                                                Background="#184FEE70"
                                                BorderBrush="#6954EE6F"
                                                BorderThickness="1"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="MONITOR"
                                                       Foreground="#54EE6F"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="58"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Voltage A-N" Style="{StaticResource ReadingName}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VoltageA_N,StringFormat={}{0:F2}}" Style="{StaticResource ReadingValue}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="V" Style="{StaticResource ReadingUnit}"/>

                                        <TextBlock Grid.Row="1" Text="Voltage B-N" Style="{StaticResource ReadingName}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VoltageB_N,StringFormat={}{0:F2}}" Style="{StaticResource ReadingValue}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="V" Style="{StaticResource ReadingUnit}"/>

                                        <TextBlock Grid.Row="2" Text="Voltage C-N" Style="{StaticResource ReadingName}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VoltageC_N,StringFormat={}{0:F2}}" Style="{StaticResource ReadingValue}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="V" Style="{StaticResource ReadingUnit}"/>

                                        <TextBlock Grid.Row="3" Text="Voltage L-N Avg" Style="{StaticResource ReadingName}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding VoltageL_N_Avg,StringFormat={}{0:F2}}" Style="{StaticResource ReadingValue}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="V" Style="{StaticResource ReadingUnit}"/>

                                        <TextBlock Grid.Row="4" Text="Current A" Style="{StaticResource ReadingName}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentA,StringFormat={}{0:F2}}" Style="{StaticResource ReadingValue}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="A" Style="{StaticResource ReadingUnit}"/>

                                        <TextBlock Grid.Row="5" Text="Current B" Style="{StaticResource ReadingName}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CurrentB,StringFormat={}{0:F2}}" Style="{StaticResource ReadingValue}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="2" Text="A" Style="{StaticResource ReadingUnit}"/>

                                        <TextBlock Grid.Row="6" Text="Current C" Style="{StaticResource ReadingName}"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CurrentC,StringFormat={}{0:F2}}" Style="{StaticResource ReadingValue}"/>
                                        <TextBlock Grid.Row="6" Grid.Column="2" Text="A" Style="{StaticResource ReadingUnit}"/>
                                    </Grid>

                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="58"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Current Avg" Style="{StaticResource ReadingName}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentAvg,StringFormat={}{0:F2}}" Style="{StaticResource ReadingValue}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="A" Style="{StaticResource ReadingUnit}"/>

                                        <TextBlock Grid.Row="1" Text="Total Active Power" Style="{StaticResource ReadingName}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalActivePower,StringFormat={}{0:F2}}" Style="{StaticResource ReadingValue}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="kW" Style="{StaticResource ReadingUnit}"/>

                                        <TextBlock Grid.Row="2" Text="Total Reactive Power" Style="{StaticResource ReadingName}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalReactivePower,StringFormat={}{0:F2}}" Style="{StaticResource ReadingValue}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="kVAR" Style="{StaticResource ReadingUnit}"/>

                                        <TextBlock Grid.Row="3" Text="Total Apparent Power" Style="{StaticResource ReadingName}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalApparentPower,StringFormat={}{0:F2}}" Style="{StaticResource ReadingValue}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="kVA" Style="{StaticResource ReadingUnit}"/>

                                        <TextBlock Grid.Row="4" Text="Frequency" Style="{StaticResource ReadingName}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Frequency,StringFormat={}{0:F2}}" Style="{StaticResource ReadingValue}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Hz" Style="{StaticResource ReadingUnit}"/>

                                        <TextBlock Grid.Row="5" Text="Power Factor" Style="{StaticResource ReadingName}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TotalPowerFactor,StringFormat={}{0:F3}}" Style="{StaticResource ReadingValue}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="2" Text="PF" Style="{StaticResource ReadingUnit}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3"
                Background="#E706111D"
                BorderBrush="#526EDFFF"
                BorderThickness="0,1,0,0">
            <Grid>
                <DataGrid ItemsSource="{Binding Events}"
                          Style="{StaticResource EventGridStyle}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#8830536B"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Height" Value="26"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Width="130" Binding="{Binding Time}"/>
                        <DataGridTextColumn Header="Source" Width="170" Binding="{Binding Source}"/>
                        <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
