<UserControl x:Class="IECGUI.View.UserSettingsView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IECGUI.ViewModel"
             xmlns:models="clr-namespace:IEC.Shared.Models;assembly=IEC.Shared"
             Height="600" Width="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="User Settings" FontSize="24" FontWeight="Bold" Foreground="White" Margin="6"/>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  RowHeight="32"
                  Margin="6"
                  Background="#31344B"
                  Foreground="White"
                  HeadersVisibility="Column">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Username" Binding="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Password" Binding="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <!-- Important: bind ItemsSource via ElementName to reach ViewModel Roles collection -->
                <DataGridComboBoxColumn Header="Role"
                                        SelectedItemBinding="{Binding Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ItemsSource="{Binding DataContext.Roles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Width="150"/>
                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, Mode=TwoWay}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="6">
            <Button Content="➕ Add User" Width="140" Height="36" Command="{Binding AddUserCommand}" Style="{StaticResource GlassButton.Ghost}" />
            <Button Content="🗑 Delete User" Width="140" Height="36" Command="{Binding DeleteUserCommand}" Style="{StaticResource GlassButton.Ghost}" />
            <Button Content="💾 Save" Width="140" Height="36" Command="{Binding SaveCommand}" Style="{StaticResource GlassButton.Blue}" />
        </StackPanel>
    </Grid>
</UserControl>