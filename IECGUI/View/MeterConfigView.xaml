<UserControl x:Class="IECGUI.View.MeterConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:IECGUI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="1080"
             d:DesignWidth="1920">
    <UserControl.Resources>
        <conv:ProtocolToVisibilityConverter x:Key="IsTcp" TargetProtocol="ModbusTcp"/>
        <conv:ProtocolToVisibilityConverter x:Key="IsRtu" TargetProtocol="ModbusRtu"/>

        <DropShadowEffect x:Key="SoftCyanGlow"
                          Color="#24DFFF"
                          BlurRadius="22"
                          ShadowDepth="0"
                          Opacity="0.18"/>

        <Style x:Key="ConfigPanel" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D0133048" Offset="0"/>
                        <GradientStop Color="#EA071827" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#7352BFE0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect" Value="{StaticResource SoftCyanGlow}"/>
        </Style>

        <Style x:Key="ConfigLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ConfigTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="39"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#3FE8FF"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#923C3E66"/>
            <Setter Property="BorderBrush" Value="#6C75DFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MeterListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#65081628"
                                BorderBrush="#3652BFE0"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="14,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#D83EEBFF"/>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#8811273A"/>
                                <Setter TargetName="ItemBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#31E7FF" BlurRadius="18" ShadowDepth="0" Opacity="0.25"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#9B3EEBFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#06111C" Offset="0"/>
                <GradientStop Color="#0A2032" Offset="0.52"/>
                <GradientStop Color="#06101A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="118"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="4" IsHitTestVisible="False" Opacity="0.32">
            <Grid.Background>
                <DrawingBrush TileMode="Tile"
                              Viewport="0,0,48,48"
                              ViewportUnits="Absolute"
                              Stretch="None">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="Transparent">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#2636DFFF" Thickness="1"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="48,0" EndPoint="48,48"/>
                                    <LineGeometry StartPoint="0,48" EndPoint="48,48"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Grid.Background>
        </Grid>

        <Grid Grid.Row="0" Background="#E706111D">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="172"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Meter Configuration"
                       Margin="20,0,0,0"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"/>
        </Grid>

        <TabControl Grid.Row="1"
                    Grid.RowSpan="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,0"/>
                    <Setter Property="Height" Value="44"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border"
                                        Background="#B31A3448"
                                        BorderBrush="#4C7ECBE5"
                                        BorderThickness="1,1,1,0"
                                        CornerRadius="5,5,0,0"
                                        Margin="4,0,0,0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      ContentSource="Header"
                                                      Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#E518819B"/>
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#793EEBFF"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#9B3EEBFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Meter List">
                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="#526EDFFF"
                            BorderThickness="0,1,0,0"
                            Background="#24091624">
                        <Button Content="Main Menu"
                                Style="{StaticResource GlassButton.Ghost}"
                                Height="50"
                                Width="230"
                                FontSize="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding MenuCommand}"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,26,0,34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="334"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="430"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="1"
                                Style="{StaticResource ConfigPanel}"
                                Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="54"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="104"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        BorderBrush="#2952BFE0"
                                        BorderThickness="0,0,0,1">
                                    <DockPanel Margin="20,0">
                                        <TextBlock Text="Meter List"
                                                   Foreground="White"
                                                   FontSize="19"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Meters.Count, StringFormat={}{0} meters}"
                                                   Foreground="#39E8FF"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Meters}"
                                         SelectedItem="{Binding SelectedMeter}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemContainerStyle="{StaticResource MeterListBoxItem}"
                                         Padding="20,18"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True">
                                                <Border Width="36"
                                                        Height="36"
                                                        CornerRadius="6"
                                                        Background="#223EEBFF"
                                                        DockPanel.Dock="Left"
                                                        Margin="0,0,12,0">
                                                    <TextBlock Text="M"
                                                               Foreground="#74F1FF"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding MeterName}"
                                                           Foreground="White"
                                                           FontSize="19"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Grid.Row="2" Margin="20,0,20,18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="44"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="44"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0"
                                            Content="Add Meter"
                                            FontSize="19"
                                            Style="{StaticResource GlassButton.Cyan}"
                                            Command="{Binding AddMeterCommand}"/>
                                    <Button Grid.Row="2"
                                            Content="Delete Meter"
                                            FontSize="19"
                                            Style="{StaticResource GlassButton.Ghost}"
                                            Command="{Binding DeleteMeterCommand}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="3"
                                Style="{StaticResource ConfigPanel}"
                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="58"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Meter Communication"
                                               Foreground="White"
                                               FontSize="20"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Ready"
                                               Foreground="#54EE6F"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </DockPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="65"/>
                                        <RowDefinition Height="73"/>
                                        <RowDefinition Height="65"/>
                                        <RowDefinition Height="65"/>
                                        <RowDefinition Height="65"/>
                                        <RowDefinition Height="65"/>
                                        <RowDefinition Height="65"/>
                                        <RowDefinition Height="65"/>
                                        <RowDefinition Height="65"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="Protocol" Style="{StaticResource ConfigLabel}"/>
                                        <ComboBox ItemsSource="{Binding Protocols}"
                                                  SelectedItem="{Binding SelectedMeter.Communication.Protocol, Mode=TwoWay}"
                                                  Style="{StaticResource GlassComboBox}"
                                                  Height="39"
                                                  FontSize="17"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="Meter Name" Style="{StaticResource ConfigLabel}"/>
                                        <TextBox Text="{Binding SelectedMeter.MeterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ConfigTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0"
                                                Visibility="{Binding SelectedMeter.Communication.Protocol, Converter={StaticResource IsRtu}}">
                                        <TextBlock Text="COM Port" Style="{StaticResource ConfigLabel}"/>
                                        <ComboBox ItemsSource="{Binding AvailableComPorts}"
                                                  SelectedItem="{Binding SelectedMeter.Communication.ComPort, Mode=TwoWay}"
                                                  Style="{StaticResource GlassComboBox}"
                                                  Height="39"
                                                  FontSize="17"/>
                                    </StackPanel>

                                    <Button Grid.Row="2" Grid.Column="2"
                                            Visibility="{Binding SelectedMeter.Communication.Protocol, Converter={StaticResource IsRtu}}"
                                            Command="{Binding RefreshComPortsCommand}"
                                            Style="{StaticResource GlassButton.Ghost}"
                                            Content="Refresh"
                                            Height="39"
                                            FontSize="16"
                                            VerticalAlignment="Bottom"/>

                                    <StackPanel Grid.Row="2" Grid.Column="0"
                                                Visibility="{Binding SelectedMeter.Communication.Protocol, Converter={StaticResource IsTcp}}">
                                        <TextBlock Text="IP" Style="{StaticResource ConfigLabel}"/>
                                        <TextBox Text="{Binding SelectedMeter.Communication.IpAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ConfigTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="2"
                                                Visibility="{Binding SelectedMeter.Communication.Protocol, Converter={StaticResource IsTcp}}">
                                        <TextBlock Text="Port" Style="{StaticResource ConfigLabel}"/>
                                        <TextBox Text="{Binding SelectedMeter.Communication.TcpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ConfigTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="0">
                                        <TextBlock Text="Baud Rate" Style="{StaticResource ConfigLabel}"/>
                                        <ComboBox ItemsSource="{Binding DataContext.BaudRates, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding SelectedMeter.Communication.BaudRate, Mode=TwoWay}"
                                                  Style="{StaticResource GlassComboBox}"
                                                  Height="39"
                                                  FontSize="17"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="2">
                                        <TextBlock Text="Parity" Style="{StaticResource ConfigLabel}"/>
                                        <ComboBox ItemsSource="{Binding DataContext.Parity, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding SelectedMeter.Communication.Parity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource GlassComboBox}"
                                                  Height="39"
                                                  FontSize="17"
                                                  ToolTip="Parity must match meter settings."/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.Column="0">
                                        <TextBlock Text="DataBits" Style="{StaticResource ConfigLabel}"/>
                                        <ComboBox ItemsSource="{Binding DataContext.DataBits, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding SelectedMeter.Communication.DataBits, Mode=TwoWay}"
                                                  Style="{StaticResource GlassComboBox}"
                                                  Height="39"
                                                  FontSize="17"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.Column="2">
                                        <TextBlock Text="StopBits" Style="{StaticResource ConfigLabel}"/>
                                        <ComboBox ItemsSource="{Binding DataContext.StopBits, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding SelectedMeter.Communication.StopBits, Mode=TwoWay}"
                                                  Style="{StaticResource GlassComboBox}"
                                                  Height="39"
                                                  FontSize="17"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="5" Grid.Column="0">
                                        <TextBlock Text="Slave ID" Style="{StaticResource ConfigLabel}"/>
                                        <ComboBox ItemsSource="{Binding DataContext.SlaveIds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding SelectedMeter.Communication.SlaveId, Mode=TwoWay}"
                                                  Style="{StaticResource GlassComboBox}"
                                                  Height="39"
                                                  FontSize="17"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="5" Grid.Column="2">
                                        <TextBlock Text="Word order" Style="{StaticResource ConfigLabel}"/>
                                        <ComboBox ItemsSource="{Binding DataContext.WordOrder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding SelectedMeter.Communication.WordOrder, Mode=TwoWay}"
                                                  Style="{StaticResource GlassComboBox}"
                                                  Height="39"
                                                  FontSize="17"/>
                                    </StackPanel>
                                </Grid>

                                <Button Grid.Row="2"
                                        Content="Save Configuration"
                                        Style="{StaticResource GlassButton.Blue}"
                                        Command="{Binding SaveCommand}"
                                        Height="48"
                                        FontSize="19"
                                        VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Register Mapping">
                <Grid Margin="24,18,24,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource ConfigPanel}"
                            Padding="12,8">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <ComboBox ItemsSource="{Binding Meters}"
                                          SelectedItem="{Binding SelectedMeter, Mode=TwoWay}"
                                          Style="{StaticResource GlassComboBox}"
                                          Width="240"
                                          Height="40"
                                          FontSize="18"
                                          Margin="0,0,10,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MeterName}" Foreground="White"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button Content="Add" Width="90" Margin="0,0,8,0" Command="{Binding AddRegisterCommand}" Style="{StaticResource GlassButton.Ghost}"/>
                                <Button Content="Edit" Width="90" Margin="0,0,8,0" Command="{Binding EditRegisterCommand}" Style="{StaticResource GlassButton.Ghost}"/>
                                <Button Content="Delete" Width="100" Margin="0,0,8,0" Command="{Binding DeleteRegisterCommand}" Style="{StaticResource GlassButton.Ghost}"/>
                                <Button Content="Save" Width="90" Margin="0,0,8,0" Command="{Binding SaveRegisterCommand}" Style="{StaticResource GlassButton.Cyan}"/>
                                <Button Content="Load Default" Width="150" Command="{Binding LoadDefaultRegistersCommand}" Style="{StaticResource GlassButton.Ghost}"/>
                            </StackPanel>

                            <Button Content="Main Menu"
                                    DockPanel.Dock="Right"
                                    Width="150"
                                    Command="{Binding MenuCommand}"
                                    Style="{StaticResource GlassButton.Ghost}"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Style="{StaticResource ConfigPanel}"
                            Margin="0,14,0,0"
                            Padding="10">
                        <DataGrid ItemsSource="{Binding SelectedMeter.Registers}"
                                  SelectedItem="{Binding SelectedRegister}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  RowHeight="34"
                                  Background="#6614263A"
                                  Foreground="White"
                                  RowBackground="#4414263A"
                                  AlternatingRowBackground="#55203349"
                                  GridLinesVisibility="None"
                                  BorderThickness="0"
                                  FontSize="16"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#8830536B"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Height" Value="40"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Parameter Name" Width="*" MinWidth="260" Binding="{Binding ParameterName}"/>
                                <DataGridTextColumn Header="Register" Width="130" Binding="{Binding RegisterAddress}"/>
                                <DataGridComboBoxColumn Header="Data Type"
                                                        Width="150"
                                                        SelectedItemBinding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"
                                                        ItemsSource="{Binding DataContext.DataTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <DataGridTextColumn Header="Unit" Width="90" Binding="{Binding Unit}"/>
                                <DataGridTextColumn Header="Scale" Width="100" Binding="{Binding ScaleFactor}"/>
                                <DataGridTextColumn Header="Length" Width="90" Binding="{Binding Length}"/>
                                <DataGridCheckBoxColumn Header="Enabled" Width="100" Binding="{Binding IsEnabled}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3"
                Background="#E706111D"
                BorderBrush="#526EDFFF"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Selected Meter: " Foreground="#DDF8FF" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedMeter.MeterName, TargetNullValue=None}" Foreground="#3EEBFF" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="   |   Protocol: " Foreground="#DDF8FF" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedMeter.Communication.Protocol, TargetNullValue=None}" Foreground="#3EEBFF" FontSize="15" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="23.40.32"
                           Foreground="#DDF8FF"
                           FontSize="13"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
