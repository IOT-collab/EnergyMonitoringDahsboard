<UserControl x:Class="IECGUI.View.ScadaDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1920" Height="1080">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource GlassButton.Cyan}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="MiniToolButton" TargetType="Button" BasedOn="{StaticResource GlassButton.Cyan}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ResizeThumb" TargetType="Thumb">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#4EC9FF"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#06111C">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#102A3E" BorderBrush="#315B73" BorderThickness="0,0,0,1" Padding="20,0,125,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="BACK" Command="{Binding BackCommand}" Style="{StaticResource GlassButton.Cyan}" Width="110" Height="40" VerticalAlignment="Center"/>
                <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CUSTOM BUILDING VIEW" Foreground="White" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="SCADA designer — create a protected plant mimic from live device data" Foreground="#9EDFF2" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="ADMIN DESIGN MODE" Foreground="#FFD27A" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#0C2030" BorderBrush="#315B73" BorderThickness="0,0,0,1" Padding="18,7">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Page" Foreground="#BCEFFF" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="180" Height="34" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" DisplayMemberPath="PageName"/>
                <TextBlock Text="Name" Foreground="#BCEFFF" FontSize="14" VerticalAlignment="Center" Margin="12,0,5,0"/>
                <TextBox Width="170" Height="32" Text="{Binding SelectedPage.PageName, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="NEW PAGE" Command="{Binding NewPageCommand}" Style="{StaticResource GlassButton.Cyan}" Width="105" Height="34" Margin="10,0,0,0"/>
                <Button Content="DELETE PAGE" Command="{Binding DeletePageCommand}" Style="{StaticResource GlassButton.Red}" Width="115" Height="34" Margin="8,0,0,0"/>
                <Button Content="SAVE LAYOUT" Command="{Binding SaveCommand}" Style="{StaticResource GlassButton.Green}" Width="125" Height="34" Margin="8,0,0,0"/>
                <Button Content="OPEN RUNTIME" Command="{Binding OpenRuntimeCommand}" Style="{StaticResource GlassButton.Cyan}" Width="125" Height="34" Margin="8,0,0,0"/>
                <Separator Width="1" Height="28" Margin="12,0"/>
                <TextBlock Text="LAYER" Foreground="#BCEFFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Button Content="GROUP" Command="{Binding GroupCommand}" Style="{StaticResource MiniToolButton}" Width="58"/>
                <Button Content="UNGROUP" Command="{Binding UngroupCommand}" Style="{StaticResource MiniToolButton}" Width="72"/>
                <Button Content="▲" ToolTip="Bring forward" Command="{Binding BringForwardCommand}" Style="{StaticResource MiniToolButton}"/>
                <Button Content="▼" ToolTip="Send backward" Command="{Binding SendBackwardCommand}" Style="{StaticResource MiniToolButton}"/>
                <Button Content="⇈" ToolTip="Bring to front" Command="{Binding BringToFrontCommand}" Style="{StaticResource MiniToolButton}"/>
                <Button Content="⇊" ToolTip="Send to back" Command="{Binding SendToBackCommand}" Style="{StaticResource MiniToolButton}"/>
                <TextBlock Text="Ctrl-click selects multiple objects" Foreground="#9EDFF2" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Text="{Binding Status}" Foreground="#BCEFFF" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Margin="18,0,0,0"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" Margin="14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#102639" BorderBrush="#315B73" BorderThickness="1" CornerRadius="7" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="OBJECTS" Foreground="White" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Button Tag="Label" Content="LABEL" Command="{Binding AddLabelCommand}" PreviewMouseMove="PaletteMouseMove" Style="{StaticResource ToolButton}"/>
                        <Button Tag="Value" Content="LIVE VALUE" Command="{Binding AddValueCommand}" PreviewMouseMove="PaletteMouseMove" Style="{StaticResource ToolButton}"/>
                        <Button Tag="Led" Content="LED / STATUS" Command="{Binding AddLedCommand}" PreviewMouseMove="PaletteMouseMove" Style="{StaticResource ToolButton}"/>
                        <Button Tag="Button" Content="WRITE BUTTON" Command="{Binding AddButtonCommand}" PreviewMouseMove="PaletteMouseMove" Style="{StaticResource ToolButton}"/>
                        <Button Tag="Line" Content="LINE" Command="{Binding AddLineCommand}" PreviewMouseMove="PaletteMouseMove" Style="{StaticResource ToolButton}"/>
                        <Button Tag="Rectangle" Content="RECTANGLE" Command="{Binding AddRectangleCommand}" PreviewMouseMove="PaletteMouseMove" Style="{StaticResource ToolButton}"/>
                        <Button Tag="Circle" Content="CIRCLE" Command="{Binding AddCircleCommand}" PreviewMouseMove="PaletteMouseMove" Style="{StaticResource ToolButton}"/>
                        <Separator Margin="0,4,0,10"/>
                        <Button Content="DELETE OBJECT" Command="{Binding DeleteWidgetCommand}" Style="{StaticResource GlassButton.Red}" Height="36" FontSize="14"/>
                        <TextBlock Text="Click to add, or drag an object onto the canvas. Select multiple objects with Ctrl-click." Foreground="#9EDFF2" TextWrapping="Wrap" FontSize="12" Margin="0,18,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="#0A1A28" BorderBrush="#315B73" BorderThickness="1" CornerRadius="7" Margin="12,0" Padding="10">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="DesignCanvas" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="#0C2131" AllowDrop="True" DragOver="CanvasDragOver" Drop="CanvasDrop" MouseLeftButtonDown="CanvasMouseDown">
                        <ItemsControl ItemsSource="{Binding Widgets}" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding Width}" Height="{Binding Height}" Background="{Binding EffectiveBackground}" BorderBrush="{Binding EffectiveForeground}" BorderThickness="1" CornerRadius="7" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" MouseLeftButtonDown="WidgetMouseDown" MouseMove="WidgetMouseMove" MouseLeftButtonUp="WidgetMouseUp">
                                        <Border.RenderTransform><RotateTransform Angle="{Binding Rotation}" CenterX="{Binding Width, FallbackValue=100, TargetNullValue=100}" CenterY="{Binding Height, FallbackValue=30, TargetNullValue=30}"/></Border.RenderTransform>
                                        <Grid IsEnabled="{Binding IsEnabled}">
                                            <TextBlock Text="{Binding DisplayValue}" Foreground="{Binding EffectiveForeground}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="{Binding IsTextVisible, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="{Binding Caption}" IsHitTestVisible="False" Background="{Binding EffectiveBackground}" Foreground="{Binding EffectiveForeground}" Style="{StaticResource GlassButton.Cyan}" Width="{Binding Width}" Height="{Binding Height}" Visibility="{Binding IsButtonVisible, Converter={StaticResource BoolToVisibility}}"/>
                                            <Ellipse Width="{Binding Height}" Height="{Binding Height}" Fill="{Binding LedBrush}" Stroke="{Binding EffectiveForeground}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLedVisible, Converter={StaticResource BoolToVisibility}}"/>
                                            <Rectangle Fill="Transparent" Stroke="{Binding EffectiveForeground}" StrokeThickness="2" RadiusX="6" RadiusY="6" Visibility="{Binding IsRectangleVisible, Converter={StaticResource BoolToVisibility}}"/>
                                            <Ellipse Fill="Transparent" Stroke="{Binding EffectiveForeground}" StrokeThickness="2" Visibility="{Binding IsCircleVisible, Converter={StaticResource BoolToVisibility}}"/>
                                            <Line X1="0" Y1="{Binding Height}" X2="{Binding Width}" Y2="0" Stroke="{Binding EffectiveForeground}" StrokeThickness="3" Visibility="{Binding IsLineVisible, Converter={StaticResource BoolToVisibility}}"/>
                                            <Thumb Style="{StaticResource ResizeThumb}" Tag="NW" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" PreviewMouseLeftButtonDown="ResizeHandleMouseDown" DragDelta="ResizeHandleDragDelta" DragCompleted="ResizeHandleDragCompleted"/>
                                            <Thumb Style="{StaticResource ResizeThumb}" Tag="N" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" PreviewMouseLeftButtonDown="ResizeHandleMouseDown" DragDelta="ResizeHandleDragDelta" DragCompleted="ResizeHandleDragCompleted"/>
                                            <Thumb Style="{StaticResource ResizeThumb}" Tag="NE" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" PreviewMouseLeftButtonDown="ResizeHandleMouseDown" DragDelta="ResizeHandleDragDelta" DragCompleted="ResizeHandleDragCompleted"/>
                                            <Thumb Style="{StaticResource ResizeThumb}" Tag="W" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" PreviewMouseLeftButtonDown="ResizeHandleMouseDown" DragDelta="ResizeHandleDragDelta" DragCompleted="ResizeHandleDragCompleted"/>
                                            <Thumb Style="{StaticResource ResizeThumb}" Tag="E" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" PreviewMouseLeftButtonDown="ResizeHandleMouseDown" DragDelta="ResizeHandleDragDelta" DragCompleted="ResizeHandleDragCompleted"/>
                                            <Thumb Style="{StaticResource ResizeThumb}" Tag="SW" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" PreviewMouseLeftButtonDown="ResizeHandleMouseDown" DragDelta="ResizeHandleDragDelta" DragCompleted="ResizeHandleDragCompleted"/>
                                            <Thumb Style="{StaticResource ResizeThumb}" Tag="S" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" PreviewMouseLeftButtonDown="ResizeHandleMouseDown" DragDelta="ResizeHandleDragDelta" DragCompleted="ResizeHandleDragCompleted"/>
                                            <Thumb Style="{StaticResource ResizeThumb}" Tag="SE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" PreviewMouseLeftButtonDown="ResizeHandleMouseDown" DragDelta="ResizeHandleDragDelta" DragCompleted="ResizeHandleDragCompleted"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="#102639" BorderBrush="#315B73" BorderThickness="1" CornerRadius="7" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="OBJECT PROPERTIES" Foreground="White" FontSize="17" FontWeight="Bold" Margin="0,0,0,14"/>
                        <TextBlock Text="Type" Foreground="#9EDFF2"/>
                        <TextBlock Text="{Binding SelectedWidget.Type}" Foreground="White" FontSize="15" Margin="0,3,0,10"/>
                        <TextBlock Text="Caption" Foreground="#9EDFF2"/>
                        <TextBox Text="{Binding SelectedWidget.Caption, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"/>
                        <TextBlock Text="Device data source" Foreground="#9EDFF2"/>
                        <ComboBox ItemsSource="{Binding AvailableDevices}" SelectedItem="{Binding SelectedWidget.DeviceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"/>
                        <TextBlock Text="Parameter / tag name" Foreground="#9EDFF2"/>
                        <TextBox Text="{Binding SelectedWidget.ParameterName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"/>
                        <TextBlock Text="Unit" Foreground="#9EDFF2"/>
                        <TextBox Text="{Binding SelectedWidget.Unit, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"/>
                        <TextBlock Text="Position (X, Y)" Foreground="#9EDFF2"/>
                        <Grid Margin="0,3,0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Grid.Column="0" Text="{Binding SelectedWidget.X, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/><TextBox Grid.Column="1" Text="{Binding SelectedWidget.Y, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,0,0"/></Grid>
                        <WrapPanel Margin="0,0,0,8"><Button Content="X−" Tag="x-" Command="{Binding AdjustCommand}" Style="{StaticResource MiniToolButton}"/><Button Content="X+" Tag="x+" Command="{Binding AdjustCommand}" Style="{StaticResource MiniToolButton}"/><Button Content="Y−" Tag="y-" Command="{Binding AdjustCommand}" Style="{StaticResource MiniToolButton}"/><Button Content="Y+" Tag="y+" Command="{Binding AdjustCommand}" Style="{StaticResource MiniToolButton}"/></WrapPanel>
                        <TextBlock Text="Size (Width, Height)" Foreground="#9EDFF2"/>
                        <Grid Margin="0,3,0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Grid.Column="0" Text="{Binding SelectedWidget.Width, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/><TextBox Grid.Column="1" Text="{Binding SelectedWidget.Height, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,0,0"/></Grid>
                        <WrapPanel Margin="0,0,0,8"><Button Content="W−" Tag="w-" Command="{Binding AdjustCommand}" Style="{StaticResource MiniToolButton}"/><Button Content="W+" Tag="w+" Command="{Binding AdjustCommand}" Style="{StaticResource MiniToolButton}"/><Button Content="H−" Tag="h-" Command="{Binding AdjustCommand}" Style="{StaticResource MiniToolButton}"/><Button Content="H+" Tag="h+" Command="{Binding AdjustCommand}" Style="{StaticResource MiniToolButton}"/></WrapPanel>
                        <TextBlock Text="Rotation" Foreground="#9EDFF2"/>
                        <TextBox Text="{Binding SelectedWidget.Rotation, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,2"/>
                        <WrapPanel Margin="0,0,0,10"><Button Content="Rotate −" Tag="r-" Command="{Binding AdjustCommand}" Style="{StaticResource MiniToolButton}" Width="70"/><Button Content="Rotate +" Tag="r+" Command="{Binding AdjustCommand}" Style="{StaticResource MiniToolButton}" Width="70"/></WrapPanel>
                        <TextBlock Text="Foreground color (#RRGGBB)" Foreground="#9EDFF2"/>
                        <TextBox Text="{Binding SelectedWidget.Foreground, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"/>
                        <TextBlock Text="Dynamic ON/OFF colors" Foreground="#9EDFF2" Margin="0,6,0,0"/>
                        <CheckBox Content="Use state colors" IsChecked="{Binding SelectedWidget.DynamicStateColors}" Foreground="White" Margin="0,3,0,6"/>
                        <ComboBox ItemsSource="{Binding ColorTargets}" SelectedItem="{Binding ColorTarget}" Height="30" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <Button Content="  " Width="30" Height="24" Background="#39E68A" Command="{Binding ApplyColorCommand}" CommandParameter="#39E68A" Margin="0,0,4,4"/><Button Content="  " Width="30" Height="24" Background="#E74C3C" Command="{Binding ApplyColorCommand}" CommandParameter="#E74C3C" Margin="0,0,4,4"/><Button Content="  " Width="30" Height="24" Background="#FFC107" Command="{Binding ApplyColorCommand}" CommandParameter="#FFC107" Margin="0,0,4,4"/><Button Content="  " Width="30" Height="24" Background="#4EC9FF" Command="{Binding ApplyColorCommand}" CommandParameter="#4EC9FF" Margin="0,0,4,4"/><Button Content="  " Width="30" Height="24" Background="#FFFFFF" Command="{Binding ApplyColorCommand}" CommandParameter="#FFFFFF" Margin="0,0,4,4"/><Button Content="  " Width="30" Height="24" Background="#19364A" Command="{Binding ApplyColorCommand}" CommandParameter="#19364A" Margin="0,0,4,4"/>
                        </WrapPanel>
                        <TextBlock Text="ON background" Foreground="#9EDFF2"/><TextBox Text="{Binding SelectedWidget.OnBackground, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
                        <TextBlock Text="OFF background" Foreground="#9EDFF2"/><TextBox Text="{Binding SelectedWidget.OffBackground, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
                        <TextBlock Text="Background color (#RRGGBB)" Foreground="#9EDFF2"/><TextBox Text="{Binding SelectedWidget.Background, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"/>
                        <CheckBox Content="Visible" IsChecked="{Binding SelectedWidget.IsVisible}" Foreground="White" Margin="0,4"/><CheckBox Content="Enabled" IsChecked="{Binding SelectedWidget.IsEnabled}" Foreground="White" Margin="0,4"/>
                        <Separator Margin="0,12,0,10"/><TextBlock Text="Live value preview" Foreground="#9EDFF2"/><TextBlock Text="{Binding SelectedWidget.LiveValue}" Foreground="#39E68A" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#122A3D" BorderBrush="#335E78" BorderThickness="1,1,1,0" Padding="18,0">
            <TextBlock Text="Designer changes are saved to the project configuration. Runtime/operator mode will use the saved layout and remain locked." Foreground="#BCEFFF" VerticalAlignment="Center" FontSize="13"/>
        </Border>
    </Grid>
</UserControl>
