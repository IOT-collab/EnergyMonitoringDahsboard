<UserControl x:Class="IECGUI.View.ReportViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             mc:Ignorable="d"
             d:DesignHeight="1080"
             d:DesignWidth="1920"
             Width="1920"
             Height="1080">
    <UserControl.Resources>
        <Style x:Key="ReportGlassPanel" TargetType="Border">
            <Setter Property="Background" Value="#B80A1A28"/>
            <Setter Property="BorderBrush" Value="#667ECBE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#48D9FF" BlurRadius="18" ShadowDepth="0" Opacity="0.14"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BCEFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ReportSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ReportStatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#48D9FF" BlurRadius="12" ShadowDepth="0" Opacity="0.66"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportActionButton" TargetType="Button" BasedOn="{StaticResource GlassButton.Cyan}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="ReportComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3348D9FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#5548D9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ReportComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Chrome"
                                    CornerRadius="7"
                                    Background="#77101F32"
                                    BorderBrush="#667ECBE5"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#48D9FF" BlurRadius="10" ShadowDepth="0" Opacity="0.12"/>
                                </Border.Effect>
                            </Border>

                            <ContentPresenter Margin="14,0,44,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                            <ToggleButton Focusable="False"
                                          HorizontalAlignment="Right"
                                          Width="42"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Path Data="M 0 0 L 5 5 L 10 0 Z"
                                      Fill="#7EEBFF"
                                      Width="10"
                                      Height="5"
                                      Stretch="Fill"/>
                            </ToggleButton>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="#F20A1A28"
                                        BorderBrush="#667ECBE5"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#AA48D9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportDateTextBox" TargetType="{x:Type primitives:DatePickerTextBox}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,0,4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid>
                            <Border x:Name="Chrome"
                                    CornerRadius="7"
                                    Background="#77101F32"
                                    BorderBrush="#667ECBE5"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#48D9FF" BlurRadius="10" ShadowDepth="0" Opacity="0.12"/>
                                </Border.Effect>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>

                                <primitives:DatePickerTextBox x:Name="PART_TextBox"
                                                              Grid.Column="0"
                                                              Style="{StaticResource ReportDateTextBox}"/>

                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Focusable="False"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CalendarChrome"
                                                    Width="32"
                                                    Height="32"
                                                    CornerRadius="6"
                                                    Background="#44101F32"
                                                    BorderBrush="#667ECBE5"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <Rectangle Height="6"
                                                               Margin="7,7,7,0"
                                                               VerticalAlignment="Top"
                                                               RadiusX="1"
                                                               RadiusY="1"
                                                               Fill="#5548D9FF"/>
                                                    <Path Data="M 5,7 L 27,7 L 27,27 L 5,27 Z M 5,12 L 27,12 M 11,4 L 11,9 M 21,4 L 21,9"
                                                          Stroke="#BCEFFF"
                                                          StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Stretch="Uniform"
                                                          Width="20"
                                                          Height="20"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CalendarChrome" Property="BorderBrush" Value="#AA48D9FF"/>
                                                    <Setter TargetName="CalendarChrome" Property="Background" Value="#6638D9FF"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="CalendarChrome" Property="Opacity" Value="0.82"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_Button}"
                                   StaysOpen="False">
                                <Border Background="#F20A1A28"
                                        BorderBrush="#667ECBE5"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4">
                                    <Calendar x:Name="PART_Calendar"
                                              SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              DisplayDate="{Binding DisplayDate, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#AA48D9FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="18"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="18"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#06111C" ClipToBounds="True">
        <Image Source="pack://application:,,,/IECGUI.Visuals;component/Images/Power4.jpg"
               Stretch="UniformToFill"
               Opacity="0.42">
            <Image.Effect>
                <BlurEffect Radius="8"/>
            </Image.Effect>
        </Image>
        <Rectangle Fill="#E006111C"/>

        <Canvas IsHitTestVisible="False" Opacity="0.3">
            <Line X1="0" Y1="790" X2="1920" Y2="790" Stroke="#3348D9FF" StrokeThickness="1"/>
            <Line X1="0" Y1="862" X2="1920" Y2="862" Stroke="#2848D9FF" StrokeThickness="1"/>
            <Line X1="0" Y1="934" X2="1920" Y2="934" Stroke="#2248D9FF" StrokeThickness="1"/>
            <Line X1="0" Y1="1006" X2="1920" Y2="1006" Stroke="#1C48D9FF" StrokeThickness="1"/>
            <Line X1="250" Y1="720" X2="-80" Y2="1080" Stroke="#2448D9FF" StrokeThickness="1"/>
            <Line X1="650" Y1="720" X2="600" Y2="1080" Stroke="#2448D9FF" StrokeThickness="1"/>
            <Line X1="1050" Y1="720" X2="1320" Y2="1080" Stroke="#2448D9FF" StrokeThickness="1"/>
            <Line X1="1450" Y1="720" X2="1900" Y2="1080" Stroke="#2448D9FF" StrokeThickness="1"/>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="86"/>
                <RowDefinition Height="140"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="92"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#B214263A"
                    BorderBrush="#667ECBE5"
                    BorderThickness="0,0,0,1"
                    Padding="30,0,172,0">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="Main Menu"
                            Command="{Binding MenuCommand}"
                            Style="{StaticResource GlassButton.Ghost}"
                            Width="180"
                            Height="44"
                            FontSize="18"
                            Margin="0,0,12,0"/>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Report Viewer"
                                   Foreground="White"
                                   FontSize="40"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Real-time logs, formatted reports, export-ready history"
                                   Foreground="#68DBEF"
                                   FontSize="16"
                                   Margin="2,-2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource ReportGlassPanel}"
                    Margin="30,18,30,0"
                    Padding="22,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="570"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="Report Format" Style="{StaticResource ReportLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding ReportFormats}"
                                      SelectedItem="{Binding SelectedReportFormat}"
                                      Style="{StaticResource ReportComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Bold"
                                                   FontSize="17"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Grid.Column="1"
                                    Content="Refresh"
                                    Command="{Binding RefreshFormatsCommand}"
                                    Style="{StaticResource GlassButton.Ghost}"
                                    Height="48"
                                    Margin="10,0,0,0"
                                    FontSize="15"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                        <TextBlock Text="From Date" Style="{StaticResource ReportLabel}"/>
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource ReportDatePicker}" Width="210"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,24,0">
                        <TextBlock Text="To Date" Style="{StaticResource ReportLabel}"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource ReportDatePicker}" Width="210"/>
                    </StackPanel>

                    <Grid Grid.Column="3" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="CONFIGURATION"
                                Command="{Binding ConfigViewCommand}"
                                Style="{StaticResource ReportActionButton}"
                                Background="#9B2EE9"
                                Margin="0,0,12,0"/>
                        <Button Grid.Column="1"
                                Content="LOAD DATA"
                                Command="{Binding LoadDataCommand}"
                                Style="{StaticResource ReportActionButton}"
                                Background="#007ACC"
                                Margin="0,0,12,0"/>
                        <Button Grid.Column="2"
                                Content="EXPORT CSV"
                                Command="{Binding ExportCsvCommand}"
                                Style="{StaticResource ReportActionButton}"
                                Background="#10B981"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="30,18,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource ReportGlassPanel}"
                        Margin="0,0,18,0"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="SAVED FORMATS" Style="{StaticResource ReportSectionTitle}" FontSize="17"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding ReportFormats}"
                                 SelectedItem="{Binding SelectedReportFormat}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="FormatCard"
                                            CornerRadius="7"
                                            BorderBrush="#337ECBE5"
                                            BorderThickness="1"
                                            Background="#66071522"
                                            Padding="12"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="White"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SelectedColumns.Count, StringFormat={}{0} columns}"
                                                       Foreground="#8FDDEA"
                                                       FontSize="13"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                            <Setter TargetName="FormatCard" Property="Background" Value="#3348D9FF"/>
                                            <Setter TargetName="FormatCard" Property="BorderBrush" Value="#AA48D9FF"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ReportGlassPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="62"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="#337ECBE5" BorderThickness="0,0,0,1">
                            <DockPanel Margin="18,0">
                                <Border DockPanel.Dock="Right"
                                        Width="250"
                                        Height="34"
                                        CornerRadius="6"
                                        Background="#77071522"
                                        BorderBrush="#557ECBE5"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Preview loaded rows"
                                               Foreground="#8FDDEA"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="12,0"/>
                                </Border>
                                <TextBlock Text="PREVIEW DATA" Style="{StaticResource ReportSectionTitle}"/>
                            </DockPanel>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ReportDataTable}"
                                  AutoGenerateColumns="True"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  RowHeight="46"
                                  FontSize="15"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="White"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#225D9DB6"
                                  VerticalGridLinesBrush="Transparent"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ColumnWidth="Auto"
                                  MinColumnWidth="150"
                                  EnableColumnVirtualization="True"
                                  EnableRowVirtualization="True"
                                  AlternationCount="2"
                                  Margin="14">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#8FDDEA"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="Background" Value="#8830536B"/>
                                    <Setter Property="BorderBrush" Value="#557ECBE5"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,2"/>
                                    <Setter Property="Height" Value="48"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="#3314263A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <Trigger Property="AlternationIndex" Value="1">
                                            <Setter Property="Background" Value="#44203349"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3348D9FF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#5548D9FF"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="30,18,30,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ReportGlassPanel}" Margin="0,0,14,0" Padding="18,12">
                    <StackPanel>
                        <TextBlock Text="Selected Format" Style="{StaticResource ReportLabel}" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedReportFormat.Name, FallbackValue=None}" Style="{StaticResource ReportStatValue}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ReportGlassPanel}" Margin="0,0,14,0" Padding="18,12">
                    <StackPanel>
                        <TextBlock Text="Columns" Style="{StaticResource ReportLabel}" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedFormatColumns.Count, FallbackValue=0}" Style="{StaticResource ReportStatValue}" Foreground="#48D9FF"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ReportGlassPanel}" Margin="0,0,14,0" Padding="18,12">
                    <StackPanel>
                        <TextBlock Text="Loaded Rows" Style="{StaticResource ReportLabel}" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalRowsLoaded}" Style="{StaticResource ReportStatValue}" Foreground="#48D9FF"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource ReportGlassPanel}" Padding="18,12">
                    <StackPanel>
                        <TextBlock Text="Export Status" Style="{StaticResource ReportLabel}" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Text="Ready" Style="{StaticResource ReportStatValue}" Foreground="#63ED8F"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
