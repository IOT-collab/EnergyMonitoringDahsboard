<UserControl x:Class="IECGUI.View.ReportViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920"
             Background="#081421">
    <!-- Modern light gray background -->

    <UserControl.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#6614263A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#667ECBE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="4" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input Label Style -->
        <Style x:Key="HmiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="HmiComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F9FAFB"/>
        </Style>

        <!-- Custom Thick ScrollBar for Touch -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="30"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="30"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- 
        REMOVED Viewbox and hardcoded Width/Height.
        This Grid will now fluidly stretch to 100% of the screen.
    -->
    <Grid Margin="30,0,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Filters -->
            <RowDefinition Height="*"/>
            <!-- DataGrid (Takes remaining space) -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <!-- 1. Header -->
            <TextBlock Grid.Row="0" 
                   Text="Report Viewer" 
                   FontSize="42" HorizontalAlignment="Left"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,0"/>
            <Button Grid.Row="0" Content="Main Menu" 
                    Style="{StaticResource GlassButton.Ghost}" 
                    Height="50" Width="230" FontSize="20"  HorizontalAlignment="Right" Margin="1350,0,0,0"
                    Command="{Binding MenuCommand}"/>

        </StackPanel>

        <!-- 2. Filter Panel -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="25" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <!-- Pushes buttons to the right -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Report Format Selection -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,30,0">
                    <TextBlock Text="Report Format" Style="{StaticResource HmiLabelStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding ReportFormats}"
                                  SelectedItem="{Binding SelectedReportFormat}"                                 
                                  Style="{StaticResource GlassComboBox}"
                                  Width="300" Height="50" >
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="20" Foreground="White"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Content="Refresh" Command="{Binding RefreshFormatsCommand}"
                                ToolTip="Refresh Report Formats"
                                Width="100" Height="50" FontSize="18" Style="{StaticResource GlassButton.Ghost}"
                               
                                BorderThickness="0" Margin="10,0,0,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <!--<TextBlock Text="↻" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>-->
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Date From -->
                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,30,0">
                    <TextBlock Text="From Date" Style="{StaticResource HmiLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding DateFrom}" 
                                Width="200" Height="50" FontSize="20" 
                                VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Date To -->
                <StackPanel Grid.Column="2" Orientation="Vertical">
                    <TextBlock Text="To Date" Style="{StaticResource HmiLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding DateTo}" 
                                Width="200" Height="50" FontSize="20" 
                                VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="CONFIGURATION" 
                            Command="{Binding ConfigViewCommand}"
                            Width="200" Height="50"
                            FontSize="20" FontWeight="Bold"
                            Background="BlueViolet" Foreground="Black" Style="{StaticResource GlassButton}"
                            BorderThickness="0" Margin="0,0,15,0" Cursor="Hand">

                    </Button>
                    <Button Content="LOAD DATA" 
                            Command="{Binding LoadDataCommand}"
                            Width="180" Height="50"
                            FontSize="20" FontWeight="Bold"
                            Background="#007ACC" Foreground="White" Style="{StaticResource GlassButton}"
                            BorderThickness="0" Margin="0,0,15,0" Cursor="Hand">

                    </Button>

                    <Button Content="EXPORT CSV" 
                            Command="{Binding ExportCsvCommand}"
                            Width="180" Height="50"
                            FontSize="20" FontWeight="Bold"
                            Background="#10B981" Foreground="White" Style="{StaticResource GlassButton}"
                            Cursor="Hand">

                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Data Grid -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,20">
            <!-- 
                 CRITICAL FIXES FOR HORIZONTAL SCROLLING:
                 1. ColumnWidth="Auto" (Forces columns to take necessary space instead of squishing)
                 2. MinColumnWidth="150" (Ensures columns don't shrink too small)
                 3. ScrollViewer.HorizontalScrollBarVisibility="Auto"
            -->
            <DataGrid ItemsSource="{Binding ReportDataTable}"
                      AutoGenerateColumns="True"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      RowHeight="50"
                      FontSize="18"
                      HeadersVisibility="Column"
                      Background="#4414263A"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#225D9DB6"
                      VerticalGridLinesBrush="Transparent"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ColumnWidth="Auto"
                      MinColumnWidth="150"
                      EnableColumnVirtualization="True"
                      EnableRowVirtualization="True"
                      AlternationCount="2">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontSize" Value="18"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="15,0"/>
                        <Setter Property="Background" Value="#8830536B"/>
                        <Setter Property="BorderBrush" Value="#557ECBE5"/>
                        <Setter Property="BorderThickness" Value="0,0,1,2"/>
                        <Setter Property="Height" Value="60"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#4414263A"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#55203349"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3348D9FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#5548D9FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="15,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>
        </Border>

        <!-- 4. Footer Status Bar -->
        <Border Grid.Row="3" CornerRadius="8" Background="#6614263A" BorderBrush="#667ECBE5" BorderThickness="1" Padding="25,15">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Selected Format Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Selected Format: " FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedReportFormat.Name, FallbackValue='None'}" 
                               FontSize="20" FontWeight="Bold" Foreground="#48D9FF" VerticalAlignment="Center"/>

                    <TextBlock Text="  |  Columns: " FontSize="20" Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <TextBlock Text="{Binding SelectedFormatColumns.Count, FallbackValue='0'}" 
                               FontSize="20" FontWeight="Bold" Foreground="#48D9FF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Row Count -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Total Rows: " FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalRowsLoaded}" 
                               FontSize="22" FontWeight="Bold" Foreground="#48D9FF" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
