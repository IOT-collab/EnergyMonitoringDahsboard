<UserControl x:Class="IECGUI.View.AlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="1080"
             d:DesignWidth="1920"
             Width="1920"
             Height="1080">
    <UserControl.Resources>
        <Style x:Key="AlarmPanel" TargetType="Border">
            <Setter Property="Background" Value="#B20A1A28"/>
            <Setter Property="BorderBrush" Value="#667ECBE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#48D9FF" BlurRadius="18" ShadowDepth="0" Opacity="0.14"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AlarmTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <Style x:Key="AlarmLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BCEFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="AlarmValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#48D9FF" BlurRadius="12" ShadowDepth="0" Opacity="0.68"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#06111C" ClipToBounds="True">
        <Image Source="pack://application:,,,/IECGUI.Visuals;component/Images/Power4.jpg"
               Stretch="UniformToFill"
               Opacity="0.45">
            <Image.Effect>
                <BlurEffect Radius="8"/>
            </Image.Effect>
        </Image>
        <Rectangle Fill="#DE06111C"/>

        <Canvas IsHitTestVisible="False" Opacity="0.32">
            <Line X1="0" Y1="790" X2="1920" Y2="790" Stroke="#3348D9FF" StrokeThickness="1"/>
            <Line X1="0" Y1="862" X2="1920" Y2="862" Stroke="#2848D9FF" StrokeThickness="1"/>
            <Line X1="0" Y1="934" X2="1920" Y2="934" Stroke="#2248D9FF" StrokeThickness="1"/>
            <Line X1="0" Y1="1006" X2="1920" Y2="1006" Stroke="#1C48D9FF" StrokeThickness="1"/>
            <Line X1="240" Y1="720" X2="-80" Y2="1080" Stroke="#2448D9FF" StrokeThickness="1"/>
            <Line X1="620" Y1="720" X2="600" Y2="1080" Stroke="#2448D9FF" StrokeThickness="1"/>
            <Line X1="1000" Y1="720" X2="1280" Y2="1080" Stroke="#2448D9FF" StrokeThickness="1"/>
            <Line X1="1380" Y1="720" X2="1840" Y2="1080" Stroke="#2448D9FF" StrokeThickness="1"/>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#B214263A"
                    BorderBrush="#667ECBE5"
                    BorderThickness="0,0,0,1"
                    Padding="10,0,172,0">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left"
                            Content="BACK"
                            Width="120"
                            Height="40"
                            Command="{Binding BackCommand}"
                            Style="{StaticResource GlassButton.Cyan}"/>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#FF746D" Margin="0,0,10,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF746D" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="Alarm supervision online"
                                   Foreground="#B8F0FF"
                                   FontSize="16"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="ALARM LOGS"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="22,0,0,0"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="36,28,36,34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,22,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="90"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource AlarmPanel}" Margin="0,0,12,0" Padding="18">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Active" Style="{StaticResource AlarmLabel}"/>
                                <TextBlock Text="{Binding AlarmService.ActiveAlarmCount}" Style="{StaticResource AlarmValue}" Foreground="#FF746D"/>
                                <TextBlock Text="running alarms" Foreground="#BCEFFF" FontSize="14"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource AlarmPanel}" Padding="18">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Critical" Style="{StaticResource AlarmLabel}"/>
                                <TextBlock Text="{Binding AlarmService.CriticalAlarmCount}" Style="{StaticResource AlarmValue}" Foreground="#FF746D"/>
                                <TextBlock Text="high priority" Foreground="#BCEFFF" FontSize="14"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource AlarmPanel}" Margin="0,22,0,0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="CONFIGURED ALARM RULES" Style="{StaticResource AlarmTitle}" FontSize="18"/>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding AlarmService.Rules}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#66071522"
                                                BorderBrush="#337ECBE5"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding AlarmName}" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding ParameterName}" Foreground="#BCEFFF" FontSize="13" Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding RangeText}" Foreground="#8FDDEA" FontSize="12" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="TEST ALARM"
                                Command="{Binding AlarmService.GenerateTestAlarmCommand}"
                                Style="{StaticResource GlassButton.Cyan}"
                                Height="54"
                                Margin="0,0,10,0"/>
                        <Button Grid.Column="1"
                                Content="CLEAR LOGS"
                                Command="{Binding AlarmService.ClearLogsCommand}"
                                Style="{StaticResource GlassButton.Ghost}"
                                Height="54"
                                Margin="10,0,0,0"/>
                    </Grid>
                </Grid>

                <Border Grid.Column="1" Style="{StaticResource AlarmPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="#337ECBE5" BorderThickness="0,0,0,1">
                            <DockPanel Margin="18,0">
                                <Border DockPanel.Dock="Right"
                                        Width="240"
                                        Height="34"
                                        CornerRadius="6"
                                        Background="#77071522"
                                        BorderBrush="#557ECBE5"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Filter by meter / severity"
                                               Foreground="#8FDDEA"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="12,0"/>
                                </Border>
                                <TextBlock Text="ALARM EVENT HISTORY"
                                           Style="{StaticResource AlarmTitle}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding AlarmService.AlarmLogs}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="Transparent"
                                  Foreground="White"
                                  BorderThickness="0"
                                  RowHeight="46"
                                  FontSize="14"
                                  Margin="18"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding RaisedAtText}" Width="190"/>
                                <DataGridTextColumn Header="Alarm Name" Binding="{Binding AlarmName}" Width="220"/>
                                <DataGridTextColumn Header="Meter" Binding="{Binding MeterName}" Width="120"/>
                                <DataGridTextColumn Header="Parameter" Binding="{Binding ParameterName}" Width="160"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="120"/>
                                <DataGridTextColumn Header="Severity" Binding="{Binding SeverityText}" Width="120"/>
                                <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="120"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
