<UserControl x:Class="IECGUI.View.EnergyMonitor2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Controls="clr-namespace:IECGUI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="1080"
             d:DesignWidth="1920"
             Width="1920"
             Height="1080">
    <UserControl.Resources>
        <Style x:Key="HudPanel" TargetType="Border">
            <Setter Property="Background" Value="#B20A1A28"/>
            <Setter Property="BorderBrush" Value="#667ECBE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#48D9FF" BlurRadius="18" ShadowDepth="0" Opacity="0.14"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HudTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HudLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BCEFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="HudValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#48D9FF" BlurRadius="12" ShadowDepth="0" Opacity="0.68"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolboxButton" TargetType="Button" BasedOn="{StaticResource GlassButton.Cyan}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="8,0,8,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="MeterCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4FBFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0"/>
        </Style>

        <Style x:Key="MeterHeaderCell" TargetType="TextBlock" BasedOn="{StaticResource MeterCell}">
            <Setter Property="Foreground" Value="#8FDDEA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8FDDEA"/>
            <Setter Property="BorderBrush" Value="#337ECBE5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#F4FBFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1838D9FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3038D9FF"/>
                    <Setter Property="BorderBrush" Value="#885AECFF"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#06111C" ClipToBounds="True">
        <Image Source="pack://application:,,,/IECGUI.Visuals;component/Images/Power4.jpg"
               Stretch="UniformToFill"
               Opacity="0.52">
            <Image.Effect>
                <BlurEffect Radius="8"/>
            </Image.Effect>
        </Image>
        <Rectangle Fill="#D706111C"/>

        <Canvas IsHitTestVisible="False" Opacity="0.34">
            <Line X1="0" Y1="790" X2="1920" Y2="790" Stroke="#3348D9FF" StrokeThickness="1"/>
            <Line X1="0" Y1="862" X2="1920" Y2="862" Stroke="#2848D9FF" StrokeThickness="1"/>
            <Line X1="0" Y1="934" X2="1920" Y2="934" Stroke="#2248D9FF" StrokeThickness="1"/>
            <Line X1="0" Y1="1006" X2="1920" Y2="1006" Stroke="#1C48D9FF" StrokeThickness="1"/>
            <Line X1="210" Y1="720" X2="-70" Y2="1080" Stroke="#2448D9FF" StrokeThickness="1"/>
            <Line X1="500" Y1="720" X2="390" Y2="1080" Stroke="#2448D9FF" StrokeThickness="1"/>
            <Line X1="790" Y1="720" X2="850" Y2="1080" Stroke="#2448D9FF" StrokeThickness="1"/>
            <Line X1="1080" Y1="720" X2="1310" Y2="1080" Stroke="#2448D9FF" StrokeThickness="1"/>
            <Line X1="1370" Y1="720" X2="1770" Y2="1080" Stroke="#2448D9FF" StrokeThickness="1"/>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#B214263A"
                    BorderBrush="#667ECBE5"
                    BorderThickness="0,0,0,1"
                    Padding="10,0,172,0">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left"
                            Content="BACK" Height="50" Width="180" FontSize="21" FontWeight="SemiBold"
                            Command="{Binding BackCommand}"
                            Style="{StaticResource GlassButton.Cyan}"/>

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                        <Ellipse Width="10" Height="10" Fill="#4BD050" Margin="0,0,10,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#4BD050" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="{Binding MeterConnectionSummary}"
                                   Foreground="#B8F0FF"
                                   FontSize="16"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="GAUGE MONITORING"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="22,0,0,0"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#B214263A"
                        BorderBrush="#667ECBE5"
                        BorderThickness="0,0,1,0">
                    <StackPanel Margin="10,18">
                        <TextBlock Text="Basic Widgets"
                                   Foreground="White"
                                   FontSize="18"
                                   Margin="5,0,5,12"/>
                        <Button Content="Button Widgets" Style="{StaticResource ToolboxButton}"/>
                        <Button Content="Lamp Widgets" Style="{StaticResource ToolboxButton}"/>
                        <Button Content="Knobs" Style="{StaticResource ToolboxButton}"/>
                        <Button Content="Utilities" Style="{StaticResource ToolboxButton}"/>
                        <Button Content="Charts" Style="{StaticResource ToolboxButton}"/>

                        <Separator Margin="10,10,10,18" Opacity="0.65"/>

                        <TextBlock Text="AI Widgets"
                                   Foreground="White"
                                   FontSize="18"
                                   Margin="5,0,5,12"/>
                        <Button Content="AI Trend" Style="{StaticResource ToolboxButton}"/>
                        <Button Content="Prediction" Style="{StaticResource ToolboxButton}"/>
                        <Button Content="Anomaly Detector" Style="{StaticResource ToolboxButton}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="26,26,26,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="118"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="126"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource HudPanel}" Margin="0,0,14,0" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="70" Height="70">
                                    <Controls:AnalogGauge/>
                                </Viewbox>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Total Current" Style="{StaticResource HudLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedMeter.CurrentAvg, StringFormat={}{0:F1}}" Style="{StaticResource HudValue}"/>
                                        <TextBlock Text=" A" Foreground="#BCEFFF" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="4,0,0,5"/>
                                    </StackPanel>
                                    <TextBlock Text="Selected incomer live" Foreground="#63ED8F" FontSize="13"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource HudPanel}" Margin="0,0,14,0" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="70" Height="70">
                                    <Controls:AnalogGauge/>
                                </Viewbox>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Voltage Health" Style="{StaticResource HudLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedMeter.VoltageL_N_Avg, StringFormat={}{0:F1}}" Style="{StaticResource HudValue}"/>
                                        <TextBlock Text=" kV" Foreground="#BCEFFF" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="4,0,0,5"/>
                                    </StackPanel>
                                    <TextBlock Text="Nominal band" Foreground="#63ED8F" FontSize="13"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource HudPanel}" Margin="0,0,14,0" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="70" Height="70">
                                    <Controls:AnalogGauge Value="{Binding SelectedMeter.TotalPowerFactor}" MinValue="0" MaxValue="1" Unit="PF"/>
                                </Viewbox>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Power Factor" Style="{StaticResource HudLabel}"/>
                                    <TextBlock Text="{Binding SelectedMeter.TotalPowerFactor, StringFormat={}{0:F2}}" Style="{StaticResource HudValue}"/>
                                    <TextBlock Text="Live calculated" Foreground="#FFC24A" FontSize="13"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource HudPanel}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="70" Height="70">
                                    <Controls:AnalogGauge Value="3" MinValue="0" MaxValue="10" Unit="AL"/>
                                </Viewbox>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Active Alarms" Style="{StaticResource HudLabel}"/>
                                    <TextBlock Text="03" Style="{StaticResource HudValue}" Foreground="#FF746D"/>
                                    <TextBlock Text="High priority watch" Foreground="#FF746D" FontSize="13"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,20,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.32*"/>
                            <ColumnDefinition Width="0.88*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource HudPanel}" Margin="0,0,20,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="56"/>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="#337ECBE5" BorderThickness="0,0,0,1">
                                    <DockPanel Margin="16,0">
                                        <Border DockPanel.Dock="Right"
                                                Width="230"
                                                Height="32"
                                                CornerRadius="6"
                                                Background="#77071522"
                                                BorderBrush="#557ECBE5"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBox Text="{Binding MeterFilter, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Filter by device name or status"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="#BCEFFF" CaretBrush="White"
                                                     FontSize="13" VerticalContentAlignment="Center" Padding="10,0"/>
                                        </Border>
                                        <TextBlock Text="METER INDEX" Style="{StaticResource HudTitle}"/>
                                    </DockPanel>
                                </Border>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,10,14,0">
                                    <Border CornerRadius="5" Background="#771AB7CC" BorderBrush="#995AECFF" BorderThickness="1" Padding="14,0" Height="28" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding MeterCount, StringFormat=All {0}}" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border CornerRadius="5" Background="#66071522" BorderBrush="#557ECBE5" BorderThickness="1" Padding="14,0" Height="28" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding ConnectedMeterCount, StringFormat=Online {0}}" Foreground="#62FF9B" FontSize="13" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <DataGrid Grid.Row="2" Margin="14,10,14,16"
                                          ItemsSource="{Binding FilteredMeters}"
                                          SelectedItem="{Binding SelectedMeter, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="None"
                                          SelectionMode="Single" SelectionUnit="FullRow"
                                          Background="Transparent" BorderThickness="0"
                                          VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Meter" Binding="{Binding MeterName}" Width="1.1*"/>
                                        <DataGridTextColumn Header="Current" Binding="{Binding CurrentAvg, StringFormat={}{0:F1} A}" Width="1.0*"/>
                                        <DataGridTextColumn Header="Voltage" Binding="{Binding VoltageL_N_Avg, StringFormat={}{0:F1} V}" Width="1.0*"/>
                                        <DataGridTextColumn Header="PF" Binding="{Binding TotalPowerFactor, StringFormat={}{0:F2}}" Width="0.75*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding MeterStatus}" Width="1.15*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource HudPanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="56"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="116"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="#337ECBE5" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding SelectedMeter.MeterName, StringFormat=SELECTED METER: {0}, TargetNullValue=SELECTED METER: NONE}"
                                               Style="{StaticResource HudTitle}"
                                               Margin="16,0"/>
                                </Border>

                                <Grid Grid.Row="1" Margin="18,14,18,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Viewbox Grid.RowSpan="2" Grid.Column="0" Margin="0,0,18,0">
                                        <Controls:AnalogGauge Title="Main Current" Unit="A" MinValue="0" MaxValue="500" Value="{Binding SelectedMeter.CurrentAvg}"/>
                                    </Viewbox>

                                    <Viewbox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                        <Controls:AnalogGauge Title="Voltage" Unit="V" MinValue="0" MaxValue="500" Value="{Binding SelectedMeter.VoltageL_N_Avg}"/>
                                    </Viewbox>

                                    <Viewbox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                        <Controls:AnalogGauge Title="Power Factor" Unit="PF" MinValue="0" MaxValue="1" Value="{Binding SelectedMeter.TotalPowerFactor}"/>
                                    </Viewbox>
                                </Grid>

                                <Grid Grid.Row="2" Margin="18,0,18,18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Last 30 min trend" Foreground="#BCEFFF" FontSize="14"/>
                                    <Canvas Grid.Row="1">
                                        <Polyline Points="0,62 55,52 110,56 165,36 220,43 275,24 330,34 385,18 440,28 495,18"
                                                  Stroke="#48D9FF"
                                                  StrokeThickness="3">
                                            <Polyline.Effect>
                                                <DropShadowEffect Color="#48D9FF" BlurRadius="12" ShadowDepth="0" Opacity="0.75"/>
                                            </Polyline.Effect>
                                        </Polyline>
                                        <Path Data="M 0,62 L 55,52 L 110,56 L 165,36 L 220,43 L 275,24 L 330,34 L 385,18 L 440,28 L 495,18 L 495,76 L 0,76 Z"
                                              Fill="#2248D9FF"/>
                                    </Canvas>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource HudPanel}" Margin="0,0,14,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Incomer Group" Style="{StaticResource HudTitle}" FontSize="16"/>
                                <DockPanel Margin="0,14,0,0">
                                    <TextBlock Text="36 meters" Foreground="#BCEFFF" FontSize="14"/>
                                    <TextBlock Text="98%" Foreground="#BCEFFF" FontSize="14" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ProgressBar Value="98" Maximum="100" Height="8" Margin="0,14,0,0" Foreground="#55EF87" Background="#33101F32"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource HudPanel}" Margin="0,0,14,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Feeder Group A" Style="{StaticResource HudTitle}" FontSize="16"/>
                                <DockPanel Margin="0,14,0,0">
                                    <TextBlock Text="126 meters" Foreground="#BCEFFF" FontSize="14"/>
                                    <TextBlock Text="92%" Foreground="#BCEFFF" FontSize="14" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ProgressBar Value="92" Maximum="100" Height="8" Margin="0,14,0,0" Foreground="#48D9FF" Background="#33101F32"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource HudPanel}" Margin="0,0,14,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Transformer Bays" Style="{StaticResource HudTitle}" FontSize="16"/>
                                <DockPanel Margin="0,14,0,0">
                                    <TextBlock Text="54 meters" Foreground="#BCEFFF" FontSize="14"/>
                                    <TextBlock Text="86%" Foreground="#BCEFFF" FontSize="14" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ProgressBar Value="86" Maximum="100" Height="8" Margin="0,14,0,0" Foreground="#FFC24A" Background="#33101F32"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource HudPanel}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Critical Watch" Style="{StaticResource HudTitle}" FontSize="16"/>
                                <DockPanel Margin="0,14,0,0">
                                    <TextBlock Text="7 meters" Foreground="#BCEFFF" FontSize="14"/>
                                    <TextBlock Text="Alarm" Foreground="#FF746D" FontSize="14" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ProgressBar Value="34" Maximum="100" Height="8" Margin="0,14,0,0" Foreground="#FF746D" Background="#33101F32"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
